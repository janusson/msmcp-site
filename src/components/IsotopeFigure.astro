---
/**
 * Isotope pattern figure — the *real* output of
 * `annotate_isotopes(identifier="C6H12O6")` from MSMCP v1.0.0, plotted.
 *
 * The numbers below are transcribed from the tool's own report (see README of
 * the MSMCP repository, section "Example: exact-mass chemistry"), not from a
 * textbook: the monoisotopic mass, the M+1 shift and the normalised abundances
 * all come from the tool.  Editing the data array is all that is needed to
 * re-plot a different compound.
 */
const compound = "C6H12O6";
const monoisotopic = 180.0634;
const peaks = [
  { label: "M", mz: 180.0634, abundance: 1.0 },
  { label: "M+1", mz: 181.0668, abundance: 0.0686 },
  { label: "M+2", mz: 182.0681, abundance: 0.0147 },
];

// Panel A: full-scale.  Panel B: the same cluster on a x100 vertical scale,
// because an isotope pattern is unreadable at full scale by construction.
const axisMin = 179.9;
const axisMax = 182.5;
const zoomMax = 0.08;

const xPercent = (mz: number) => ((mz - axisMin) / (axisMax - axisMin)) * 100;
const fullHeight = (a: number) => a * 100;
const zoomHeight = (a: number) => (a / zoomMax) * 100;

const description =
  `Isotope pattern for ${compound}, computed by annotate_isotopes: ` +
  `monoisotopic peak ${monoisotopic} m/z at relative abundance 1.0000, ` +
  peaks
    .slice(1)
    .map((p) => `${p.label} at ${p.mz} m/z with relative abundance ${p.abundance.toFixed(4)}`)
    .join(", ") +
  ". The lower panel repeats the M+1 and M+2 region on a one-hundred-fold vertical scale.";
---

<figure class="card p-5">
  <figcaption class="mb-4">
    <span class="eyebrow">Tool output · annotate_isotopes</span>
    <p class="mt-1.5 font-mono text-[0.8rem] text-ink-soft">
      annotate_isotopes(<span class="text-accent-ink">"C6H12O6"</span>)
    </p>
  </figcaption>

  <div class="relative h-32 border-b border-l border-line" role="img" aria-label={description}>
    {
      peaks.map((p) => (
        <span
          class="absolute bottom-0 w-[2px] -translate-x-1/2"
          style={`left:${xPercent(p.mz)}%;height:${fullHeight(p.abundance)}%;background:var(--color-accent);`}
        />
      ))
    }
    <!-- 50 % abundance guide -->
    <span
      class="absolute left-0 right-0 border-t border-dashed border-line-soft"
      style="bottom:50%;"></span>
  </div>

  <!-- Labels are positioned from the same m/z axis as the sticks: evenly
       spaced labels would sit under the wrong peak. -->
  <div class="relative mt-1 h-4 text-[0.66rem] text-ink-mute">
    {
      peaks.map((p) => (
        <span
          class="absolute font-mono whitespace-nowrap"
          style={`left:${xPercent(p.mz)}%;transform:translateX(-50%);`}
        >
          {p.label} · {p.mz.toFixed(4)}
        </span>
      ))
    }
  </div>

  <div class="mt-5 flex items-baseline justify-between">
    <span class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-mute"
      >Relative abundance, ×100 zoom</span
    >
    <span class="font-mono text-[0.7rem] text-ink-mute">M = 1.0000</span>
  </div>

  <div class="relative mt-2 h-20 border-b border-l border-line">
    {
      peaks
        .slice(1)
        .map((p) => (
          <span
            class="absolute bottom-0 w-[2px] -translate-x-1/2"
            style={`left:${xPercent(p.mz)}%;height:${zoomHeight(p.abundance)}%;background:var(--color-accent);`}
          />
        ))
    }
    {
      peaks.slice(1).map((p) => (
        <span
          class="absolute font-mono text-[0.68rem] text-accent-ink"
          style={`left:${xPercent(p.mz)}%;bottom:${zoomHeight(p.abundance)}%;transform:translate(-50%,-0.35rem);`}
        >
          {p.abundance.toFixed(4)}
        </span>
      ))
    }
  </div>

  <p class="mt-3 text-[0.75rem] leading-relaxed text-ink-mute">
    M+1 and M+2 are shown on a separate scale; on the full-scale panel above they are 6.86 % and
    1.47 % of the base peak. Values are the tool's output, reproduced without rounding.
  </p>
</figure>
