---
import BaseLayout from "../layouts/BaseLayout.astro";
import IsotopeFigure from "../components/IsotopeFigure.astro";
import ReferenceFlow from "../components/ReferenceFlow.astro";

const title = "MSMCP — an MCP server for mass spectrometry data";
const description =
  "An open-source MCP server that lets an AI assistant read your own mzML, MGF and imzML files: precursor and isotope checks, MS/MS library matching and QC, computed locally.";

const REPO = "https://github.com/janusson/MSMCP";

/* These are the published PyPI command and stdio-server configurations.
   Keeping the same pinned command across quickstart and client configs makes
   onboarding directly testable and prevents drift back to a source checkout. */
const installSnippet = "uvx --python 3.13 --from msmcp==1.0.2 msmcp";
const pipInstallSnippet = "pip install msmcp==1.0.2";
const uvToolSnippet = "uv tool install --python 3.13 msmcp==1.0.2";

const claudeSnippet = JSON.stringify(
  {
    mcpServers: {
      msmcp: {
        command: "uvx",
        args: ["--python", "3.13", "--from", "msmcp==1.0.2", "msmcp"],
        env: { MSMCP_ALLOWED_ROOT: "/absolute/path/to/ms-data" },
      },
    },
  },
  null,
  2,
);

const zedSnippet = JSON.stringify(
  {
    context_servers: {
      msmcp: {
        command: "uvx",
        args: ["--python", "3.13", "--from", "msmcp==1.0.2", "msmcp"],
        env: { MSMCP_ALLOWED_ROOT: "/absolute/path/to/ms-data" },
      },
    },
  },
  null,
  2,
);

const instrumentClasses = [
  {
    name: "generic",
    note: "default",
    precursor: "5.0 ppm",
    ms2: "0.02 Da",
    snr: "5 / 20",
  },
  {
    name: "orbitrap",
    note: "accurate mass",
    precursor: "5.0 ppm",
    ms2: "0.01 Da",
    snr: "5 / 20",
  },
  {
    name: "tof",
    note: "reflectron TOF",
    precursor: "15.0 ppm",
    ms2: "0.05 Da",
    snr: "5 / 20",
  },
  {
    name: "ion_trap",
    note: "unit resolution",
    precursor: "0.5 Da",
    ms2: "0.5 Da",
    snr: "5 / 20",
  },
  {
    name: "triple_quad",
    note: "unit resolution",
    precursor: "0.7 Da",
    ms2: "0.7 Da",
    snr: "5 / 20",
  },
];

const validationSummary = [
  {
    status: "VALIDATED",
    capability: "Exact-mass chemistry",
    detail:
      "annotate_isotopes (exact multinomial expansion collapsed to nominal centroids; AME2020/CIAAW constants cited) and predict_adduct_offset (14 canonical adducts; CODATA constants).",
  },
  {
    status: "PARTIAL",
    capability: "mzML 1.1.0, similarity & MCP",
    detail:
      "mzML float32/64 + zlib decoding against an independent writer (vendor quirks and Numpress excluded); ClassicalScorer vs matchms 0.33.1 on MassBank 2026.03 positive ESI MS2; stdio + SHA-256 provenance.",
  },
  {
    status: "NOT VALIDATED",
    capability: "Search significance, MGF & imzML",
    detail:
      "Production search reports similarity rankings only (p/q-values and FDR are withdrawn). MGF, imzML, and embedding scorers lack independent reference validation. Hardware control is permanently out of scope.",
  },
];

const envVars = [
  {
    name: "MSMCP_ALLOWED_ROOT",
    defaultVal: "process working directory",
    effect:
      "Directory subtree that all file-reading tools (including library paths) are confined to.",
  },
  {
    name: "MSMCP_MAX_FILE_SIZE_BYTES",
    defaultVal: "500 MiB",
    effect: "Per-file ceiling, enforced on inflated bytes for .gz and zlib-compressed arrays.",
  },
  {
    name: "MSMCP_MAX_SPECTRA",
    defaultVal: "1000",
    effect:
      "Per-request spectrum cap for indexed loads and QC scans (extract_chromatograms caps at 10,000).",
  },
  {
    name: "MSMCP_MAX_REFERENCES",
    defaultVal: "128",
    effect:
      "Maximum live ptr:spectrum:… handles held in server memory before new registrations fail.",
  },
  {
    name: "MSMCP_MAX_TOTAL_BYTES",
    defaultVal: "512 MiB",
    effect: "Total payload ceiling across active server-side data references.",
  },
  {
    name: "MSMCP_REFERENCE_TTL_SECONDS",
    defaultVal: "3600",
    effect: "Reference expiration in seconds (0 disables lazy expiry).",
  },
  {
    name: "MSMCP_EMBEDDING_BACKEND",
    defaultVal: "real",
    effect: "real requires installed DreaMS/LSM-MS2 weights; mock selects test-only stand-ins.",
  },
];

const reproducibleExamples = [
  {
    title: "Synthetic caffeine search",
    href: `${REPO}/tree/1.0.2/examples`,
    note: "Committed MGF/MSP demo files; mechanics only, not an identification.",
  },
  {
    title: "Glucose isotope envelope",
    href: `${REPO}/blob/1.0.2/SCIENTIFIC_VALIDATION.md#4-capability-2--exact-mass-and-isotope-calculations`,
    note: "Independent reference values and scope for the exact-mass calculation.",
  },
  {
    title: "Similarity validation reproduction",
    href: `${REPO}/blob/1.0.2/VALIDATION_SIMILARITY.md#reproduction`,
    note: "Pinned MassBank/matchms experiment; partial validation, not calibrated confidence.",
  },
];

/* The tool surface, as the 1.0.2 server advertises it: fifteen registrations
   across src/msmcp/tools/*.py. Every call below uses the released argument
   names; descriptions stay within what the corresponding tool returns. */
const toolGuide = [
  {
    id: "inspection",
    area: "Inspection and references",
    tools: [
      {
        name: "load_mzml_summary",
        mode: "read-only",
        output: "text summary",
        ask: "What is in this file?",
        call: `load_mzml_summary(file_path="/data/run.mzML", max_spectra=5)`,
        returns:
          "Per spectrum: MS level, retention time, total ion current, peak count, base peak (with optional noise_threshold filter; max_spectra 1–50). The footer states the file's total spectrum count.",
      },
      {
        name: "list_spectra",
        mode: "read-only",
        output: "text index",
        ask: "Which spectra are MS2, and which index do I want?",
        call: `list_spectra(file_path="/data/run.mzML", ms_level=2)`,
        returns:
          "An index table — spectrum index, MS level, retention time, precursor m/z, peak count — across .mzML, .mzML.gz, .mgf, .mgf.gz, or .imzML (supports ms_level, min_peaks, and max_spectra up to 1,000).",
      },
      {
        name: "load_spectrum",
        mode: "read-only",
        output: "metadata + ptr handle",
        ask: "Hold one spectrum server-side.",
        call: `load_spectrum(file_path="/data/run.mzML", spectrum_index=0)`,
        returns:
          "Metadata plus a ptr:spectrum:… handle. The peak array stays in the server's memory instead of entering the conversation; index must sit below MSMCP_MAX_SPECTRA.",
      },
      {
        name: "summarise_reference",
        mode: "read-only",
        output: "text + provenance",
        ask: "What is behind this handle?",
        call: `summarise_reference(reference="ptr:spectrum:264a5ae9…")`,
        returns:
          "The same compact spectrum block, read from memory rather than the file, followed by the reference's provenance.",
      },
      {
        name: "release_reference",
        mode: "state-changing · idempotent",
        output: "confirmation",
        ask: "Free that memory now rather than waiting for expiry.",
        call: `release_reference(reference="ptr:spectrum:264a5ae9…")`,
        returns:
          "Confirmation. Releasing an unknown or already-released reference is reported, not raised, so a retry is safe.",
      },
    ],
  },
  {
    id: "chemistry",
    area: "Exact-mass chemistry",
    tools: [
      {
        name: "validate_precursor",
        mode: "read-only",
        output: "verdict + ppm",
        ask: "Does this precursor mass fit the formula I think it does?",
        call: `validate_precursor(theoretical_mass=180.0634, experimental_mass=180.0634)`,
        returns:
          "Mass error and a PASSED or REJECTED verdict against the optional instrument_class (default generic: 5.0 ppm; unit-resolution classes use Da).",
      },
      {
        name: "predict_adduct_offset",
        mode: "read-only",
        output: "mass shift",
        ask: "What does [M+H]+ add, exactly?",
        call: `predict_adduct_offset(adduct_string="[M+H]+")`,
        returns:
          "Polarity, charge state, exact mass shift in daltons and offset formula for 14 canonical adducts: [M+H]+, [M+Na]+, [M+K]+, [M+NH4]+, [M+H-H2O]+, [M+2H]2+, [M+3H]3+, [M+2Na-H]+, [M-H]-, [M+Cl]-, [M+HCOO]-, [M+CH3COO]-, [M-H2O-H]-, and [M+Na-2H]-. Anything else is refused.",
      },
      {
        name: "annotate_isotopes",
        mode: "read-only",
        output: "isotope table",
        ask: "What should the isotope envelope look like for this formula?",
        call: `annotate_isotopes(identifier="C6H12O6", isotopologues=3)`,
        returns:
          "Monoisotopic mass and M … M+(n-1) masses (isotopologues 1–10) with abundances normalised to M = 1.0000 via exact multinomial expansion (collapsed to nominal centroids). Set is_smiles=True with msmcp[chem] for SMILES input; fails closed without RDKit.",
      },
    ],
  },
  {
    id: "similarity",
    area: "Spectral similarity",
    tools: [
      {
        name: "compute_cosine",
        mode: "read-only",
        output: "score + unmatched peaks",
        ask: "How similar are these two MS/MS spectra?",
        call: `compute_cosine(query_peaks=[[100.0, 1.0]], reference_peaks=[[100.0, 1.0]])`,
        returns:
          "A cosine score and matched/unmatched peak details. Each side accepts inline peaks or a ptr:spectrum:… reference (query_reference / reference_reference). Defaults to scoring_method='classical' (greedy 1-to-1 matching under ms2_tolerance or instrument_class); 'dreams' and 'lsm-ms2' require model weights.",
      },
    ],
  },
  {
    id: "chromatograms",
    area: "Chromatograms",
    tools: [
      {
        name: "extract_chromatograms",
        mode: "read-only",
        output: "structuredContent (v1.0)",
        ask: "Extract TIC, BPC and target-ion traces from an mzML acquisition.",
        call: `extract_chromatograms(file_path="/data/run.mzML", targets_mz=[195.0877], tolerance=5.0, tolerance_unit="ppm", ms_level=1)`,
        returns:
          "Structured scan-level traces (schema_version '1.0' in structuredContent) with mandatory SHA-256 digest and completeness metadata. Accepts up to 20 XIC targets, optional retention_time_range_min, and up to 10,000 scanned spectra. No smoothing, blank subtraction or identification is performed.",
      },
    ],
  },
  {
    id: "qc",
    area: "Quality control",
    tools: [
      {
        name: "generate_qc_summary",
        mode: "read-only",
        output: "QC report",
        ask: "Was this run worth searching?",
        call: `generate_qc_summary(file_path="/data/run.mzML")`,
        returns:
          "Spectrum and total-ion-current counts, peak density, estimated signal-to-noise ratio, and diagnostic-ion prevalence (optional instrument_class). Scans up to MSMCP_MAX_SPECTRA and states when full-acquisition coverage is unconfirmed.",
      },
    ],
  },
  {
    id: "search",
    area: "Library search",
    tools: [
      {
        name: "search_library",
        mode: "read-only",
        output: "async job ID",
        ask: "Match this MS2 against the library I already have.",
        call: `search_library(database_file="/data/libraries/MassBank.msp", spectrum_reference="ptr:spectrum:…", scoring_method="classical")`,
        returns:
          "Returns a job ID immediately (accepts spectrum_reference or experimental_file + spectrum_index, plus optional instrument_class). Reads .msp/.msp.gz and .mgf/.mgf.gz from disk behind the allowed root; unrecognised paths fall back to a labelled synthetic library. Refuses non-MS2 queries and gates candidates on precursor tolerance, polarity, charge and adduct; reports similarity rankings only.",
      },
      {
        name: "check_search_status",
        mode: "read-only",
        output: "status / ranked report",
        ask: "Is the scan finished?",
        call: `check_search_status(job_id="2aafd7b8f1c44b42a987a34b0f724610")`,
        returns:
          "Queued, running, completed, failed or cancelled — then delivers the full ranked report once (later polls return a short digest unless full_report=True), naming the scorer, tolerances, library source and provenance.",
      },
      {
        name: "cancel_search",
        mode: "state-changing · idempotent",
        output: "cancellation",
        ask: "Stop the scan.",
        call: `cancel_search(job_id="2aafd7b8f1c44b42a987a34b0f724610")`,
        returns:
          "Cancellation. A job that already finished is reported as finished, and a cancelled scan's partial work is discarded.",
      },
    ],
  },
  {
    id: "diagnostics",
    area: "Diagnostics",
    tools: [
      {
        name: "ping",
        mode: "read-only",
        output: "health status",
        ask: "Is the server alive?",
        call: `ping()`,
        returns:
          "Operational status and optional imaging-distribution metadata. This does not verify imzML compatibility; call it first when another tool fails unexpectedly.",
      },
    ],
  },
];

const docs = [
  {
    label: "PyPI package 1.0.2",
    href: "https://pypi.org/project/msmcp/1.0.2/",
    note: "published distribution · Python 3.13+",
  },
  {
    label: "GitHub release 1.0.2",
    href: `${REPO}/releases/tag/1.0.2`,
    note: "release notes and tagged source",
  },
  {
    label: "Scientific validation status",
    href: `${REPO}/blob/1.0.2/SCIENTIFIC_VALIDATION.md`,
    note: "what is, and is not, independently validated",
  },
  {
    label: "Architecture and security",
    href: `${REPO}/blob/1.0.2/ARCHITECTURE.md`,
    note: "boundaries, transport and limitations",
  },
  {
    label: "Configuration reference",
    href: `${REPO}/blob/1.0.2/README.md#configuration-reference`,
    note: "environment variables and local file access",
  },
  {
    label: "Chromatograms schema",
    href: `${REPO}/blob/1.0.2/docs/chromatograms.md`,
    note: "structuredContent 1.0, TIC/BPC/XIC rules and bounds",
  },
  {
    label: "Similarity validation",
    href: `${REPO}/blob/1.0.2/VALIDATION_SIMILARITY.md`,
    note: "bounded independent comparison; status PARTIAL",
  },
  { label: "Changelog", href: `${REPO}/blob/1.0.2/CHANGELOG.md`, note: "release history" },
  { label: "Questions & bug reports", href: `${REPO}/issues`, note: "GitHub Issues" },
];
---

<BaseLayout title={title} description={description}>
  {
    /* ===================================================================
      Hero
      =================================================================== */
  }
  <section id="top" class="shell pt-14 pb-16 md:pt-20 md:pb-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
      <div class="min-w-0">
        <p class="eyebrow">Open-source MCP server · Mass spectrometry</p>

        <h1
          class="mt-5 text-balance text-display font-bold leading-[1.12] tracking-[-0.02em] text-head"
        >
          Ask your AI assistant about your mass spectrometry data.
        </h1>

        <p class="mt-6 max-w-2xl text-lead leading-relaxed text-ink">
          MSMCP puts your own data in front of an AI client — Claude, Zed, or any other MCP host.
          Ask it to open an mzML, MGF or imzML file, check a precursor mass against a formula,
          compute isotope and adduct patterns, score an MS/MS spectrum against your MSP library, or
          summarise QC across a run.
        </p>

        <p class="hero-thesis mt-5 max-w-2xl">The model reasons. The tools compute.</p>

        <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
          MCP — the Model Context Protocol — is the open standard that lets an assistant call tools
          and read files it is given. MSMCP is the mass spectrometry end of it.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary" href="#get-started">
            Get started <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="#example"> See an example </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2">
          <li class="chip">15 tools</li>
          <li class="chip">mzML · MGF · imzML</li>
          <li class="chip">stdio, local only</li>
          <li class="chip">no credentials</li>
          <li class="chip">MIT</li>
        </ul>
      </div>

      <div class="min-w-0 space-y-6">
        <div class="card p-4">
          <p class="text-note font-medium text-ink-mute">Run it now</p>
          <pre
            class="mono-block mt-2 p-3 text-note whitespace-pre-wrap [overflow-wrap:anywhere]"
            aria-label="Install commands"><code>{installSnippet}</code></pre>
        </div>
        <ReferenceFlow />
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Example
      =================================================================== */
  }
  <section id="example" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Reproducible demo · release 1.0.2</p>
    <h2 class="mt-3 section-heading">A synthetic library search, not a chemical finding.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      The release includes a small caffeine MGF query and an MSP library. Put both files under the
      configured allowed root, load the MS2 spectrum, dispatch a search, then poll its job. The
      fixture deliberately duplicates a library record, so this verifies the tool flow — not
      identification accuracy or scientific significance.
    </p>

    <div class="mt-8 overflow-hidden card">
      <div class="border-b border-line-soft px-5 py-3 text-note text-ink-mute">
        synthetic fixture · MSMCP 1.0.2 · stdio
      </div>
      <div class="p-5">
        <div class="space-y-4">
          <div>
            <p class="eyebrow">0 · Prompt to your assistant</p>
            <div
              class="mt-2 rounded-lg border border-line bg-panel-soft px-3.5 py-2.5 text-small text-ink"
            >
              &ldquo;Load <code>/data/caffeine_spectrum.mgf</code> and search it against{" "}
              <code>/data/caffeine_library.msp</code> with{" "}
              <code>instrument_class="orbitrap"</code>.&rdquo;
            </div>
          </div>
          <div>
            <p class="eyebrow">1 · Load the query</p>
            <div class="mono-block mt-2 p-3 text-note whitespace-pre-wrap [overflow-wrap:anywhere]">
              <code>load_spectrum(file_path="/data/caffeine_spectrum.mgf", spectrum_index=0)</code>
            </div>
          </div>
          <div>
            <p class="eyebrow">2 · Search and poll</p>
            <div class="mono-block mt-2 p-3 text-note whitespace-pre-wrap [overflow-wrap:anywhere]">
              <code
                >search_library(database_file="/data/caffeine_library.msp",
                spectrum_reference="ptr:spectrum:…", scoring_method="classical",
                instrument_class="orbitrap")</code
              >
            </div>
            <div class="mono-block mt-2 p-3 text-note whitespace-pre-wrap [overflow-wrap:anywhere]">
              <code>{`check_search_status(job_id="<job ID returned by search_library>")`}</code>
            </div>
          </div>
          <div class="min-w-0 rounded-lg border border-line bg-panel-soft p-4">
            <p class="text-note font-medium text-ink-mute">Example candidate report</p>
            <div
              class="mt-3 overflow-x-auto"
              tabindex="0"
              role="region"
              aria-label="Synthetic caffeine search result"
            >
              <table class="w-full text-left text-note">
                <caption class="sr-only">Synthetic caffeine library search result</caption>
                <thead>
                  <tr class="text-note uppercase tracking-wider text-ink-mute">
                    <th scope="col" class="py-2 pr-3 font-medium">Rank</th>
                    <th scope="col" class="py-2 pr-3 font-medium">Candidate</th>
                    <th scope="col" class="py-2 pr-3 text-right font-medium">Score</th>
                    <th scope="col" class="py-2 text-right font-medium">Precursor m/z</th>
                  </tr>
                </thead>
                <tbody class="font-mono">
                  <tr class="border-t border-line-soft">
                    <td class="py-2 pr-3">1</td>
                    <td class="py-2 pr-3 font-sans text-ink"
                      >Caffeine <span class="block text-note text-ink-mute">C8H10N4O2</span></td
                    >
                    <td class="py-2 pr-3 text-right text-head">1.0000</td>
                    <td class="py-2 text-right text-ink-soft">195.0877</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="mt-3 text-note leading-relaxed text-ink-mute">
              These are fabricated demonstration spectra and an exact synthetic match. The score is
              a ranking value, not an identification probability or error rate.
            </p>
          </div>
        </div>
      </div>
      <div class="border-t border-line-soft px-5 py-4 text-note leading-relaxed text-ink-mute">
        Reproduce with the <a
          class="prose-link"
          href={`${REPO}/tree/1.0.2/examples`}
          target="_blank"
          rel="noopener">release 1.0.2 example files</a
        >. Before ranking, <code>search_library</code> refuses non-MS2 queries, applies the chosen instrument
        class's precursor tolerance, and excludes records whose polarity, charge or adduct conflicts (entries
        omitting context remain ranked as <em>unknown</em>). Production search reports
        similarity-ranked candidates only; it does not report p-values, q-values or calibrated FDR.
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Why MSMCP
      =================================================================== */
  }
  <section id="why" class="shell scroll-mt-24 pb-16 md:pb-24">
    <h2 class="section-heading">Grounded, deterministic, and honest about its own boundaries.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      LLMs should reason about mass spectrometry, not perform the arithmetic. Every scientific value
      on this page is a tool's output rather than a model's recollection, and every derived result
      carries a record of how it was made. That is the standard AI-assisted mass spectrometry should
      be held to, and MSMCP is infrastructure for it.
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      <article class="card p-5">
        <h3 class="font-mono text-base font-semibold text-head">Grounded analysis</h3>
        <p class="mt-3 leading-relaxed text-ink-soft">
          MSMCP computes exact masses, adduct shifts, isotope envelopes, ppm gates and cosine scores
          in deterministic Python tools. The glucose isotope figure below shows output from the
          released tool.
        </p>
      </article>

      <article class="card p-5">
        <h3 class="font-mono text-base font-semibold text-head">Deterministic and auditable</h3>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Long searches run as jobs that a client can poll. Loaded spectra and search reports
          include provenance for their inputs and parameters; a score remains a ranking, not a
          confidence estimate.
        </p>
      </article>

      <article class="card p-5">
        <h3 class="font-mono text-base font-semibold text-head">Data control</h3>
        <p class="mt-3 leading-relaxed text-ink-soft">
          MSMCP runs locally over stdio, makes no network calls of its own, and confines file reads
          to an allowed root under size caps. The host still controls the process with your
          permissions, so anyone who can drive that client can drive MSMCP; run it on a machine you
          own, never as a network service. See the{" "}
          <a class="prose-link" href={`${REPO}/blob/1.0.2/README.md#security-notes`}
            >security notes</a
          >.
        </p>
      </article>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="min-w-0">
        <IsotopeFigure />
      </div>
      <div class="card min-w-0 p-5">
        <p class="eyebrow">Also verified in the tree</p>
        <ul class="mt-4 space-y-3 text-small leading-relaxed text-ink-soft">
          <li>
            <span class="font-mono text-note text-ink">15 tools</span> across inspection, chemistry, similarity,
            chromatograms, quality control and library search. Their names match the 1.0.2 server's registered
            tool surface.
          </li>
          <li>
            <span class="font-mono text-note text-ink">Readers</span> for mzML (including zlib-compressed
            arrays, parsed by MSMCP itself), strict MGF, and imzML imaging data through the optional extra.
            Vendor formats are refused with conversion guidance.
          </li>
          <li>
            <span class="font-mono text-note text-ink">MSP/NIST and MGF libraries</span>{" "}
            are read from disk behind the same security boundary as an acquisition, so{" "}
            <code>search_library</code> can search supported local libraries without an upload or hosted
            service.
          </li>
          <li>
            <span class="font-mono text-note text-ink">Similarity validation</span> is documented as PARTIAL:
            the pinned comparison is reproducible, but it does not establish open-set accuracy or calibrated
            confidence.
          </li>
          <li>
            <span class="font-mono text-note text-ink">Spectral foundation models</span>{" "}
            plug in behind one adapter (DreaMS runs real inference; LSM-MS2 awaits public weights). Core
            MSMCP never requires model weights — and if a model is unavailable it says so rather than
            returning a number that looks learned.
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="card min-w-0 p-5">
        <h3 class="font-mono text-base font-semibold text-head">Instrument-class defaults</h3>
        <p class="mt-2 text-small leading-relaxed text-ink-soft">
          Tools that apply tolerances accept <code>instrument_class</code> and record the chosen defaults
          in provenance. Unit-resolution classes use Da rather than ppm because a fixed ppm gate shrinks
          below 1 Da at small-molecule masses.
        </p>
        <div
          class="mt-4 overflow-x-auto"
          tabindex="0"
          role="region"
          aria-label="Instrument class default tolerances"
        >
          <table class="w-full text-left text-note">
            <caption class="sr-only">MSMCP 1.0.2 instrument class default tolerances</caption>
            <thead>
              <tr class="text-note uppercase tracking-wider text-ink-mute">
                <th scope="col" class="py-2 pr-3 font-medium">Class</th>
                <th scope="col" class="py-2 pr-3 font-medium">Precursor</th>
                <th scope="col" class="py-2 pr-3 font-medium">MS2 / diag.</th>
                <th scope="col" class="py-2 text-right font-medium">SNR bands</th>
              </tr>
            </thead>
            <tbody class="font-mono">
              {
                instrumentClasses.map((ic) => (
                  <tr class="border-t border-line-soft">
                    <td class="py-2 pr-3">
                      <div class="text-head">{ic.name}</div>
                      <div class="font-sans text-note text-ink-mute">{ic.note}</div>
                    </td>
                    <td class="py-2 pr-3 text-ink">{ic.precursor}</td>
                    <td class="py-2 pr-3 text-ink-soft">{ic.ms2}</td>
                    <td class="py-2 text-right text-ink-soft">{ic.snr}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-note leading-relaxed text-ink-mute">
          These are documented conventions, not measured from raw file headers;{" "}
          <code>compute_cosine</code> also accepts an explicit <code>ms2_tolerance</code> override in
          Da.
        </p>
      </div>

      <div class="card min-w-0 p-5">
        <h3 class="font-mono text-base font-semibold text-head">Validation status (1.0.2)</h3>
        <p class="mt-2 text-small leading-relaxed text-ink-soft">
          Passing unit tests is not scientific validation. MSMCP separates software tests from
          independent evidence in{" "}
          <a
            class="prose-link"
            href={`${REPO}/blob/1.0.2/SCIENTIFIC_VALIDATION.md`}
            target="_blank"
            rel="noopener">SCIENTIFIC_VALIDATION.md</a
          >.
        </p>
        <dl class="mt-4 space-y-3 text-small leading-relaxed">
          {
            validationSummary.map((item) => (
              <div class="border-t border-line-soft pt-3">
                <dt class="flex flex-wrap items-baseline gap-2">
                  <span class="font-mono text-note font-semibold text-accent-ink">
                    {item.status}
                  </span>
                  <span class="font-medium text-head">{item.capability}</span>
                </dt>
                <dd class="mt-1 text-note text-ink-soft">{item.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Get started
      =================================================================== */
  }
  <section id="get-started" class="shell scroll-mt-24 pb-16 md:pb-24">
    <h2 class="section-heading">Install MSMCP 1.0.2 from PyPI.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      MSMCP 1.0.2 is published on PyPI and requires Python 3.13 or later. Install it in an isolated
      environment with <a class="prose-link" href="https://docs.astral.sh/uv/">uv</a>; the command
      below is pinned to the published version. No API key, account or hosted service is needed.
    </p>

    <div class="mt-7 grid gap-6 lg:grid-cols-2">
      <div class="min-w-0 space-y-6">
        <div>
          <h3 class="text-note font-semibold uppercase tracking-[0.14em] text-ink-mute">
            PyPI quickstart (recommended)
          </h3>
          <pre
            class="mono-block mt-3 p-4 text-ink"
            tabindex="0"><code class="text-ink">{installSnippet}</code></pre>
          <p class="mt-3 text-small leading-relaxed text-ink-soft">
            This is the stdio server command for your MCP host. The release wheel is fetched from
            PyPI into uv's isolated tool environment; source cloning is not required.
          </p>
        </div>

        <div class="card p-5">
          <h3 class="text-note font-semibold uppercase tracking-[0.14em] text-ink-mute">
            pip, uv tool &amp; optional extras
          </h3>
          <div class="mono-block mt-3 space-y-1 p-3.5 text-ink" tabindex="0">
            <div><code class="text-ink">{uvToolSnippet}</code></div>
            <div><code class="text-ink">{pipInstallSnippet}</code></div>
          </div>
          <dl class="mt-4 space-y-2.5 text-note leading-relaxed text-ink-soft">
            <div>
              <dt class="font-mono text-ink">msmcp[imaging]</dt>
              <dd>
                Adds imzML (+ <code>.ibd</code>) reading via <code>massflow&gt;=0.1.2,&lt;0.2</code
                >. Keep separate from the unrelated analytical <code>MassFlow</code> engine; importing
                the imaging package creates a <code>logs/</code> directory in the working directory.
              </dd>
            </div>
            <div>
              <dt class="font-mono text-ink">msmcp[chem]</dt>
              <dd>
                Installs RDKit for SMILES-to-formula conversion in{" "}
                <code>annotate_isotopes(is_smiles=True)</code>. Explicit formulas work in the core
                install without RDKit.
              </dd>
            </div>
            <div>
              <dt class="font-mono text-ink">msmcp[ml] + dreams</dt>
              <dd>
                Installs PyTorch for embedding similarity; DreaMS weights require installing{" "}
                <code>dreams</code> from source, and LSM-MS2 awaits public weights.
              </dd>
            </div>
            <div>
              <dt class="font-mono text-ink">pynumpress</dt>
              <dd>
                Optional decoder required only if your <code>.mzML</code> files use MS-Numpress compression
                (zlib-compressed mzML works out of the box).
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="min-w-0 space-y-6">
        <div>
          <h3 class="text-note font-semibold uppercase tracking-[0.14em] text-ink-mute">
            Claude Desktop &amp; standard MCP hosts
          </h3>
          <pre
            class="mono-block mt-3 p-4 text-ink"
            tabindex="0"><code class="text-ink">{claudeSnippet}</code></pre>
          <p class="mt-3 text-small leading-relaxed text-ink-soft">
            Uses the standard <code>mcpServers</code> schema. Keep <code>uvx</code> on the host's{
              " "
            }
            <code>PATH</code> (or pass its full path) and point{" "}
            <code>MSMCP_ALLOWED_ROOT</code> at the directory containing your acquisitions and libraries.
          </p>
        </div>

        <div>
          <h3 class="text-note font-semibold uppercase tracking-[0.14em] text-ink-mute">
            Zed configuration
          </h3>
          <pre
            class="mono-block mt-3 p-4 text-ink"
            tabindex="0"><code class="text-ink">{zedSnippet}</code></pre>
          <p class="mt-3 text-small leading-relaxed text-ink-soft">
            Uses Zed's <code>context_servers</code> schema with the exact same pinned{" "}
            <code>uvx</code> command and <code>MSMCP_ALLOWED_ROOT</code> boundary. Once connected, ask
            your assistant to run <code>ping</code> or inspect a file inside the allowed root.
          </p>
        </div>
      </div>
    </div>

    <div class="card mt-8 p-5">
      <h3 class="font-mono text-base font-semibold text-head">Environment configuration</h3>
      <p class="mt-2 text-small leading-relaxed text-ink-soft">
        Every runtime limit has a conservative default; if <code>MSMCP_ALLOWED_ROOT</code> is unset, it
        defaults to the server's working directory. Set these in your MCP client's{" "}
        <code>env</code> block when needed.
      </p>
      <div
        class="mt-4 overflow-x-auto"
        tabindex="0"
        role="region"
        aria-label="MSMCP environment variables"
      >
        <table class="w-full text-left text-note">
          <caption class="sr-only">MSMCP 1.0.2 environment configuration variables</caption>
          <thead>
            <tr class="text-note uppercase tracking-wider text-ink-mute">
              <th scope="col" class="py-2 pr-4 font-medium">Variable</th>
              <th scope="col" class="py-2 pr-4 font-medium">Default</th>
              <th scope="col" class="py-2 font-medium">Effect</th>
            </tr>
          </thead>
          <tbody>
            {
              envVars.map((v) => (
                <tr class="border-t border-line-soft">
                  <td class="py-2 pr-4 font-mono text-head whitespace-nowrap">{v.name}</td>
                  <td class="py-2 pr-4 font-mono text-accent-ink whitespace-nowrap">
                    {v.defaultVal}
                  </td>
                  <td class="py-2 text-ink-soft">{v.effect}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Tools
      =================================================================== */
  }
  <section id="tools" class="shell scroll-mt-24 pb-16 md:pb-24">
    <h2 class="section-heading">15 tools, one question each.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      Every call below matches the signature and defaults the server advertises in{" "}
      <code>tools/list</code>. When a spectrum is loaded with <code>load_spectrum</code>,{" "}
      <code>summarise_reference</code>, <code>compute_cosine</code> and{" "}
      <code>search_library</code> accept its <code>ptr:spectrum:…</code> handle instead of copying peaks
      across MCP/JSON.
    </p>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Tool categories">
      {
        toolGuide.map((group) => (
          <a
            href={`#tools-${group.id}`}
            class="chip transition-colors hover:border-accent hover:text-accent-ink"
          >
            {group.area}
          </a>
        ))
      }
    </nav>

    <div class="mt-9 space-y-9">
      {
        toolGuide.map((group) => (
          <section aria-labelledby={`tools-${group.id}`}>
            <h3 id={`tools-${group.id}`} class="scroll-mt-24 text-small font-semibold text-head">
              {group.area}
            </h3>
            <dl class="mt-3">
              {group.tools.map((tool) => (
                <div
                  class="grid gap-1 border-t border-line-soft py-4 sm:grid-cols-[14rem_1fr] sm:gap-6"
                  data-tool={tool.name}
                >
                  <dt class="min-w-0">
                    <span class="block font-mono text-note font-medium text-head">{tool.name}</span>
                    <span class="mt-1 block font-mono text-note text-ink-mute">
                      {tool.mode} · {tool.output}
                    </span>
                  </dt>
                  <dd class="min-w-0">
                    <p class="text-small text-ink">{tool.ask}</p>
                    <div class="mono-block mt-2 p-3 text-note whitespace-pre-wrap [overflow-wrap:anywhere]">
                      <code>{tool.call}</code>
                    </div>
                    <p class="mt-2 text-note leading-relaxed text-ink-soft">{tool.returns}</p>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    <div class="card mt-8 p-5">
      <h3 class="font-mono text-base font-semibold text-head">MCP integration notes</h3>
      <ul class="mt-3 space-y-2 text-note leading-relaxed text-ink-soft">
        <li>
          <span class="font-mono text-ink">Transport &amp; framing:</span> JSON-RPC over{" "}
          <code>stdio</code> (<code>mcp[cli]&gt;=2.2.0</code>). Diagnostics write to{" "}
          <code>stderr</code>; <code>stdout</code> carries MCP framing only.
        </li>
        <li>
          <span class="font-mono text-ink">Annotations:</span> all 15 tools declare{" "}
          <code>open_world_hint=False</code>. Thirteen are <code>read_only_hint=True</code>; only{
            " "
          }
          <code>release_reference</code> and <code>cancel_search</code> mark state mutation (both{
            " "
          }
          <code>idempotent_hint=True</code>).
        </li>
        <li>
          <span class="font-mono text-ink">Structured outputs:</span>{" "}
          <code>extract_chromatograms</code> publishes an MCP <code>outputSchema</code> (
          <code>schema_version: "1.0"</code>) and returns parallel arrays in{" "}
          <code>structuredContent</code>.
        </li>
        <li>
          <span class="font-mono text-ink">Async execution:</span>
          <code>search_library</code>{" "}
          uses an in-memory job executor (4 concurrent jobs max, 1-hour finished-job TTL) polled via{
            " "
          }
          <code>check_search_status</code>; MSMCP does not implement the MCP Tasks protocol, and
          in-flight jobs do not survive a server restart.
        </li>
        <li>
          <span class="font-mono text-ink">Failure modes:</span> boundary, format, and dependency failures
          (<code>PathEscapeError</code>, <code>UnsupportedFormatError</code>,{" "}
          <code>MalformedFileError</code>, <code>MissingDependencyError</code>,{" "}
          <code>SpectrumCountExceededError</code>, <code>EmbeddingBackendUnavailable</code>) surface
          as MCP tool errors with diagnostic details in <code>stderr</code> logs.
        </li>
      </ul>
    </div>
  </section>

  {
    /* ===================================================================
      Docs and links
      =================================================================== */
  }
  <section id="docs" class="shell scroll-mt-24 pb-8">
    <h2 class="section-heading">Everything authoritative lives with the code.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      The package, release notes and scientific documentation are pinned to 1.0.2 so their contracts
      stay aligned with this page.
    </p>

    <ul class="mt-7 grid gap-3 sm:grid-cols-2">
      {
        docs.map((d) => (
          <li>
            <a
              class="card flex h-full flex-col gap-1 p-4 transition-colors hover:border-accent"
              href={d.href}
              target="_blank"
              rel="noopener"
            >
              <span class="text-small font-semibold text-ink">{d.label}</span>
              <span class="font-mono text-note text-ink-mute">{d.note} ↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h3 class="mt-10 text-small font-semibold uppercase tracking-[0.14em] text-ink-mute">
      Reproducible examples
    </h3>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        reproducibleExamples.map((example, index) => (
          <li data-example={index + 1}>
            <a
              class="card flex h-full flex-col gap-2 p-4 transition-colors hover:border-accent"
              href={example.href}
              target="_blank"
              rel="noopener"
            >
              <span class="text-small font-semibold text-ink">{example.title}</span>
              <span class="text-note leading-relaxed text-ink-mute">{example.note}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-small text-ink-soft">
      <span class="font-semibold text-ink">Contact.</span> There is no mailing list and no contact form.
      Bug reports, questions and feature discussion belong in{" "}
      <a class="prose-link" href={`${REPO}/issues`}>GitHub Issues</a>, where the answer stays
      searchable for the next person.
    </p>
  </section>
</BaseLayout>
