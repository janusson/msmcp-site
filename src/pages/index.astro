---
import BaseLayout from "../layouts/BaseLayout.astro";
import IsotopeFigure from "../components/IsotopeFigure.astro";
import ReferenceFlow from "../components/ReferenceFlow.astro";

const title = "MSMCP — an MCP server for mass spectrometry data";
const description =
  "An open-source MCP server that lets an AI assistant read your own mzML, MGF and imzML files: precursor and isotope checks, MS/MS library matching and QC, computed locally.";

const REPO = "https://github.com/janusson/MSMCP";

/* Code snippets live here rather than inline: a JSON block in markup would be
   parsed as an Astro expression. */
const installSnippet = [
  "git clone https://github.com/janusson/MSMCP.git",
  "cd MSMCP",
  "uv sync --extra dev      # creates .venv, installs runtime + dev dependencies",
  "uv run msmcp             # serves MCP over stdio",
].join("\n");

const zedSnippet = JSON.stringify(
  {
    context_servers: {
      msmcp: {
        command: "/absolute/path/to/uv",
        args: ["run", "--directory", "/absolute/path/to/MSMCP", "msmcp"],
        env: { MSMCP_ALLOWED_ROOT: "/absolute/path/to/ms-data" },
      },
    },
  },
  null,
  2,
);

/* The result of search_library -> check_search_status, from a real run:
   a Bruker maXis LC-MS/MS acquisition (spectrum #966, RT 3.795 min, precursor
   m/z 315.2321, 220 peaks) searched against MassBank's public MSP library
   (63,879 spectra) with classical greedy peak matching at +/-0.02 Da. */
const hits = [
  { rank: 1, id: "EQ362902", name: "Δ⁹-tetrahydrocannabinol", cosine: "0.8309", q: "0.0125" },
  { rank: 2, id: "AU158302", name: "Δ⁹-tetrahydrocannabinol", cosine: "0.7842", q: "0.0125" },
  { rank: 3, id: "AU158301", name: "Δ⁹-tetrahydrocannabinol", cosine: "0.6958", q: "0.0333" },
  { rank: 4, id: "AU107706", name: "progesterone", cosine: "0.6922", q: "0.0333" },
  { rank: 5, id: "AU107702", name: "progesterone", cosine: "0.6862", q: "0.0333" },
  { rank: 6, id: "EQ362901", name: "Δ⁹-tetrahydrocannabinol", cosine: "0.6827", q: "0.0333" },
];

/* The tool surface, as the server advertises it: fourteen registrations in
   src/msmcp/tools/*.py, checked against `tools/list` by the project's own
   contract test.  Every call below is a real signature — the argument names and
   defaults are the ones a client receives — and the words on the right are what
   the tool's report actually contains, not a wish list. */
const toolGuide = [
  {
    id: "inspection",
    area: "Inspection and references",
    tools: [
      {
        name: "load_mzml_summary",
        ask: "What is in this file?",
        call: `load_mzml_summary(file_path="/data/run.mzML", max_spectra=5)`,
        returns:
          "Per spectrum: MS level, retention time, total ion current, peak count, base peak. The footer states the file's total spectrum count.",
      },
      {
        name: "list_spectra",
        ask: "Which spectra are MS2, and which index do I want?",
        call: `list_spectra(file_path="/data/run.mzML", ms_level=2)`,
        returns:
          "An index table — spectrum index, MS level, retention time, precursor m/z, peak count — so the next call names a real spectrum.",
      },
      {
        name: "load_spectrum",
        ask: "Hold one spectrum server-side.",
        call: `load_spectrum(file_path="/data/run.mzML", spectrum_index=966)`,
        returns:
          "Metadata plus a ptr:spectrum:… handle. The peak array stays in the server's memory instead of entering the conversation.",
      },
      {
        name: "summarise_reference",
        ask: "What is behind this handle?",
        call: `summarise_reference(reference="ptr:spectrum:264a5ae9…")`,
        returns:
          "The same compact spectrum block, read from memory rather than the file, followed by the reference's provenance.",
      },
      {
        name: "release_reference",
        ask: "Free that memory now rather than waiting for expiry.",
        call: `release_reference(reference="ptr:spectrum:264a5ae9…")`,
        returns:
          "Confirmation. Releasing an unknown or already-released reference is reported, not raised, so a retry is safe.",
      },
    ],
  },
  {
    id: "chemistry",
    area: "Exact-mass chemistry",
    tools: [
      {
        name: "validate_precursor",
        ask: "Does this precursor mass fit the formula I think it is?",
        call: `validate_precursor(theoretical_mass=315.2320, experimental_mass=315.2321)`,
        returns:
          "Mass error and a PASSED or REJECTED verdict against the named instrument class — 5.0 ppm for the generic class — with the tolerance stated.",
      },
      {
        name: "predict_adduct_offset",
        ask: "What does [M+H]+ add, exactly?",
        call: `predict_adduct_offset(adduct_string="[M+H]+")`,
        returns:
          "Polarity, charge state, exact mass shift in daltons and the offset formula. One of fourteen canonical adducts; anything else is refused.",
      },
      {
        name: "annotate_isotopes",
        ask: "What should the isotope envelope look like for this formula?",
        call: `annotate_isotopes(identifier="C6H12O6", isotopologues=3)`,
        returns:
          "Monoisotopic mass and the M, M+1, M+2 masses with relative abundances normalised to M = 1.0000, from the exact multinomial expansion.",
      },
    ],
  },
  {
    id: "similarity",
    area: "Spectral similarity",
    tools: [
      {
        name: "compute_cosine",
        ask: "How similar are these two MS/MS spectra?",
        call: `compute_cosine(query_reference="ptr:spectrum:…", reference_peaks=[[mz, intensity], …])`,
        returns:
          "A cosine score under the class's m/z window with the matched-peak count, computed by greedy one-to-one peak matching.",
      },
    ],
  },
  {
    id: "qc",
    area: "Quality control",
    tools: [
      {
        name: "generate_qc_summary",
        ask: "Was this run worth searching?",
        call: `generate_qc_summary(file_path="/data/run.mzML")`,
        returns:
          "Spectrum and total-ion-current counts, peak density, an estimated signal-to-noise ratio and diagnostic-ion prevalence. Reads the whole file, so it is the slow inspection call.",
      },
    ],
  },
  {
    id: "search",
    area: "Library search",
    tools: [
      {
        name: "search_library",
        ask: "Match this MS2 against the library I already have.",
        call: `search_library(database_file="/data/libraries/MassBank.msp", spectrum_reference="ptr:spectrum:…", scoring_method="classical")`,
        returns:
          "A job ID straight away. The MSP library is read from disk through the same boundary as an acquisition, and the scan runs in the background.",
      },
      {
        name: "check_search_status",
        ask: "Is the scan finished?",
        call: `check_search_status(job_id="2aafd7b8…")`,
        returns:
          "Running, completed or failed — then the ranked report, naming the scorer, tolerances, library source and provenance.",
      },
      {
        name: "cancel_search",
        ask: "Stop the scan.",
        call: `cancel_search(job_id="2aafd7b8…")`,
        returns:
          "Cancellation. A job that already finished is reported as finished, and a cancelled scan's partial work is discarded.",
      },
    ],
  },
  {
    id: "diagnostics",
    area: "Diagnostics",
    tools: [
      {
        name: "ping",
        ask: "Is the server alive, and can it see its dependencies?",
        call: `ping()`,
        returns:
          "Operational status and the MassFlow version it can import. Call it first when another tool fails unexpectedly.",
      },
    ],
  },
];

const docs = [
  { label: "Quick start & tool reference", href: `${REPO}#quick-start`, note: "README" },
  {
    label: "Architecture, layers & limitations",
    href: `${REPO}/blob/main/ARCHITECTURE.md`,
    note: "ARCHITECTURE.md",
  },
  {
    label: "Scientific validation status",
    href: `${REPO}/blob/main/SCIENTIFIC_VALIDATION.md`,
    note: "what is, and is not, validated",
  },
  {
    label: "Security notes",
    href: `${REPO}#security-notes`,
    note: "allowed root, size caps, stdio-only",
  },
  {
    label: "Configuration reference",
    href: `${REPO}#configuration-reference`,
    note: "environment variables",
  },
  { label: "Roadmap", href: `${REPO}/blob/main/docs/roadmap.md`, note: "plan of record" },
  { label: "Changelog", href: `${REPO}/blob/main/CHANGELOG.md`, note: "release history" },
  { label: "Release 1.0.0", href: `${REPO}/releases/tag/1.0.0`, note: "tagged release" },
  { label: "Questions & bug reports", href: `${REPO}/issues`, note: "GitHub Issues" },
];
---

<BaseLayout title={title} description={description}>
  {
    /* ===================================================================
      Hero
      =================================================================== */
  }
  <section id="top" class="shell pt-14 pb-16 md:pt-20 md:pb-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
      <div class="min-w-0">
        <p class="eyebrow">Open-source MCP server · Mass spectrometry</p>

        <h1
          class="mt-5 text-balance text-[clamp(2rem,5.2vw,3.1rem)] font-bold leading-[1.12] tracking-[-0.02em] text-head"
        >
          Ask your AI assistant about your mass spectrometry data.
        </h1>

        <p class="mt-6 max-w-2xl text-[1.08rem] leading-relaxed text-ink">
          MSMCP puts your own data in front of an AI client — Claude, Zed, or any other MCP host.
          Ask it to open an mzML, MGF or imzML file, check a precursor mass against a formula,
          compute isotope and adduct patterns, score an MS/MS spectrum against your MSP library, or
          summarise QC across a run. The model plans and interprets; the tools compute, on your
          machine.
        </p>

        <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">
          MCP — the Model Context Protocol — is the open standard that lets an assistant call tools
          and read files it is given. MSMCP is the mass spectrometry end of it.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary" href="#get-started"
            >Get started <span aria-hidden="true">→</span></a
          >
          <a class="btn btn-ghost" href="#example">See an example</a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2">
          <li class="chip">14 tools</li>
          <li class="chip">mzML · MGF · imzML</li>
          <li class="chip">stdio, local only</li>
          <li class="chip">no credentials</li>
          <li class="chip">MIT</li>
        </ul>
      </div>

      <ReferenceFlow />
    </div>
  </section>

  {
    /* ===================================================================
      Example
      =================================================================== */
  }
  <section id="example" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Example</p>
    <h2 class="mt-3 max-w-3xl rule-heading">One question, four tool calls.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      The transcript below is a real run of MSMCP against a real acquisition and a real spectral
      library. The library scan is the slow step, and it never blocks the conversation — it is
      dispatched as a job and polled.
    </p>

    <div class="mt-8 overflow-hidden card">
      <div class="border-b border-line-soft px-5 py-3 text-[0.75rem] text-ink-mute">
        session · MSMCP 1.0.0 over stdio · reference and job IDs shortened
      </div>

      <div class="space-y-6 p-5">
        {/* turn 1 — the question */}
        <div class="flex gap-3">
          <span class="mt-0.5 font-mono text-[0.7rem] uppercase tracking-wider text-ink-mute"
            >You</span
          >
          <p class="text-ink">
            “I have a peak eluting at 3.80 min, precursor m/z 315.2321, MS2. Is it Δ⁹-THC?”
          </p>
        </div>

        {/* turn 2 — inspect */}
        <div class="space-y-2 border-l-2 border-accent-soft pl-4">
          <p class="font-mono text-[0.78rem] text-accent-ink">
            load_spectrum(file_path="experiment.mzML", spectrum_index=966)
          </p>
          <div class="mono-block px-3.5 py-2.5 text-ink-soft">
            kind=spectrum &nbsp;format=mzML &nbsp;backend=msmcp.mzml &nbsp;ms_level=2<br />
            precursor_mz=315.2321 &nbsp;n_peaks=220 &nbsp;mz_range=[65.0382, 318.2416]<br />
            reference=<span class="text-accent-ink">"ptr:spectrum:264a5ae9…"</span>
            <span class="text-ink-mute">← the 220 peaks stay on the server</span>
          </div>
        </div>

        {/* turn 3 — ppm gate */}
        <div class="space-y-2 border-l-2 border-accent-soft pl-4">
          <p class="font-mono text-[0.78rem] text-accent-ink">
            validate_precursor(theoretical_mass=315.2320, experimental_mass=315.2321)
          </p>
          <div class="mono-block px-3.5 py-2.5 text-ink-soft">
            <span class="text-head">VALIDATION PASSED</span> — mass error <span class="text-head"
              >0.32 ppm</span
            >, within the 5.0 ppm gate for the generic instrument class.
          </div>
        </div>

        {/* turn 4 — dispatch */}
        <div class="space-y-2 border-l-2 border-accent-soft pl-4">
          <p class="font-mono text-[0.78rem] text-accent-ink">
            search_library(spectrum_reference="ptr:spectrum:264a5ae9…",
            database_file="libraries/MASSBANK.msp", scoring_method="classical")
          </p>
          <div class="mono-block px-3.5 py-2.5 text-ink-soft">
            Job ID: <span class="text-accent-ink">2aafd7b8…</span> — scanner reads the library from disk
            through the security boundary and searches it for real. The tool call returns immediately.
          </div>
        </div>

        {/* turn 5 — poll */}
        <div class="space-y-2 border-l-2 border-accent-soft pl-4">
          <p class="font-mono text-[0.78rem] text-accent-ink">
            check_search_status(job_id="2aafd7b8…") <span class="text-ink-mute">→ running</span> …
            <br />
            check_search_status(job_id="2aafd7b8…") <span class="text-ink-mute">→ completed</span>
          </p>

          <div class="card overflow-x-auto bg-panel-soft">
            <table class="w-full min-w-[34rem] text-left text-[0.82rem]">
              <caption class="px-4 pt-4 text-left text-[0.78rem] text-ink-mute">
                63,879 library spectra scored against 220 query peaks · classical greedy peak
                matching, ±0.02 Da · 94.9 s · 6 hits at q ≤ 0.05
              </caption>
              <thead>
                <tr class="text-[0.72rem] uppercase tracking-wider text-ink-mute">
                  <th scope="col" class="px-4 py-2 font-medium">Rank</th>
                  <th scope="col" class="px-4 py-2 font-medium">Candidate (MassBank accession)</th>
                  <th scope="col" class="px-4 py-2 text-right font-medium">Cosine</th>
                  <th scope="col" class="px-4 py-2 text-right font-medium">q-value</th>
                </tr>
              </thead>
              <tbody class="font-mono">
                {
                  hits.map((h) => (
                    <tr class="border-t border-line-soft">
                      <td class="px-4 py-2 text-ink-mute">{h.rank}</td>
                      <td class="px-4 py-2 font-sans">
                        <span class="text-ink">{h.name}</span>
                        <span class="ml-2 text-[0.74rem] text-ink-mute">{h.id} · C21H30O2</span>
                      </td>
                      <td class="px-4 py-2 text-right text-head">{h.cosine}</td>
                      <td class="px-4 py-2 text-right text-ink-soft">{h.q}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <p class="text-[0.85rem] text-ink-soft">
            The report MSMCP returns leads with its own caveat: these are candidate library matches
            ranked by the stated scorer and significance model, not validated compound
            identifications. Note the competition — the runner-up candidates are progesterone, a
            constitutional isomer at the same precursor m/z. That is what a deterministic score buys
            an analytical chemist: the whole field, not one confident answer. The q-values beside
            those candidates are the tool's own significance estimate and are not yet calibrated —
            MSMCP's scientific validation record marks that capability not validated — so read them
            as a ranking aid, not as an error rate.
          </p>
        </div>
      </div>

      <div class="border-t border-line-soft px-5 py-4 text-[0.76rem] leading-relaxed text-ink-mute">
        Provenance of this transcript: MSMCP 1.0.0: <code>search_library</code> with{" "}
        <code>scoring_method="classical"</code>, run against MassBank's public MSP library (63,879
        spectra) read from disk, querying spectrum #966 of a Bruker maXis LC–MS/MS acquisition (RT
        3.795 min, precursor m/z 315.2321, 220 peaks, m/z range 65.0382–318.2416). The ppm verdict
        is a fresh <code>validate_precursor</code> call against MassBank's reference mass. Beyond shortened
        IDs, relative library paths and a stand-in filename for the acquisition, the numbers are the tools'
        own output, unedited — and the acquisition's real filename is not published here.
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Why MSMCP
      =================================================================== */
  }
  <section id="why" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Why MSMCP</p>
    <h2 class="mt-3 max-w-3xl rule-heading">
      Grounded, deterministic, and honest about its own boundaries.
    </h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      LLMs should reason about mass spectrometry, not perform the arithmetic. Every scientific value
      on this page is a tool's output rather than a model's recollection, and every derived result
      carries a record of how it was made. That is the standard AI-assisted mass spectrometry should
      be held to, and MSMCP is infrastructure for it.
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      <article class="card p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Grounded analysis</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          The model calls the tool; the tool does the chemistry. Exact masses, adduct shifts,
          isotope envelopes, ppm gates and cosine scores are computed by pure, unit-tested Python —
          the same functions every time, answering the same way. The model never invents a mass and
          never does the arithmetic.
        </p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          The isotope envelope on this page is <code>annotate_isotopes</code> output for glucose; the
          0.32 ppm verdict above is <code>validate_precursor</code> output. Neither was written by a language
          model.
        </p>
      </article>

      <article class="card p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">
          Deterministic and auditable
        </h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Reproducible execution is separated from the model's variable interpretation. Fast
          operations return immediately; long ones — a library scan is minutes — are dispatched to a
          job executor and polled, so a client timeout can never truncate a result.
        </p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Every derived object carries an immutable provenance record: the operation, its
          parameters, the source file with reader backend and SHA-256 digest, the parent references,
          and the software and model versions. When an answer is wrong, you can tell whether the
          tool failed or the interpretation did.
        </p>
      </article>

      <article class="card p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Data control</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          MSMCP runs as a local child process on stdio: it makes no network calls of its own, stores
          no credentials, and ships no library data. Every file read is confined to one allowed
          root, under file-size and spectrum-count caps, and a path that escapes that root —
          symlinks included — is refused rather than read.
        </p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Its boundary is stated, not implied: the host spawns the server with your credentials, so
          anyone who can drive your LLM client can drive the server. Run it on a machine you own,
          and never expose it as a network service.
        </p>
      </article>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="min-w-0"><IsotopeFigure /></div>
      <div class="card min-w-0 p-5">
        <p class="eyebrow">Also verified in the tree</p>
        <ul class="mt-4 space-y-3 text-[0.88rem] leading-relaxed text-ink-soft">
          <li>
            <span class="font-mono text-[0.8rem] text-ink">14 tools</span> across inspection, chemistry,
            similarity, quality control and library search — every one asserted by the test suite, and
            the wire schemas checked separately so no parameter reaches a model undocumented.
          </li>
          <li>
            <span class="font-mono text-[0.8rem] text-ink">Readers</span> for mzML (including zlib-compressed
            arrays, parsed by MSMCP itself), strict MGF, and imzML imaging data through MassFlow. Vendor
            formats are refused with conversion guidance instead of a stack trace.
          </li>
          <li>
            <span class="font-mono text-[0.8rem] text-ink">MSP/NIST libraries</span> are read from disk
            behind the same security boundary as an acquisition, so <code>search_library</code> searches
            the libraries you already have — no upload, no hosted service.
          </li>
          <li>
            <span class="font-mono text-[0.8rem] text-ink">Empirical evaluation</span> ships with the
            code: a notebook drives the real server end to end and fails the gate if a registered tool
            is never exercised or a workflow's context cost grows by half.
          </li>
          <li>
            <span class="font-mono text-[0.8rem] text-ink">Spectral foundation models</span> plug in behind
            one adapter (DreaMS runs real inference; LSM-MS2 awaits public weights). Core MSMCP never
            requires model weights — and if a model is unavailable it says so rather than returning a
            number that looks learned.
          </li>
        </ul>
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Get started
      =================================================================== */
  }
  <section id="get-started" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Get started</p>
    <h2 class="mt-3 rule-heading">Install from source: clone, sync, run.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      MSMCP is not published to PyPI yet, so there is no package to install and no binary to
      download: the path today is a clone, synced with <a
        class="prose-link"
        href="https://docs.astral.sh/uv/">uv</a
      >. You need <code>uv</code> and Python 3.13, which <code>.python-version</code> pins for you. No
      API key, no account, no server to sign up for.
    </p>

    <div class="mt-7 grid gap-6 lg:grid-cols-2">
      <div class="min-w-0">
        <h3 class="text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ink-mute">
          Clone, sync, run
        </h3>
        <pre
          class="mono-block mt-3 p-4 text-ink"><code class="text-ink">{installSnippet}</code></pre>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          Optional extras: <code>--extra chem</code> adds RDKit so SMILES can be converted to a formula;
          embedding-based scoring needs the DreaMS model installed separately from source. Neither is
          required for the core server.
        </p>
      </div>

      <div class="min-w-0">
        <h3 class="text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ink-mute">
          Point a client at it
        </h3>
        <pre class="mono-block mt-3 p-4 text-ink"><code class="text-ink">{zedSnippet}</code></pre>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          Shown for Zed's <code>context_servers</code>; any host that can spawn a stdio MCP server
          configures the same command and arguments. Replace all three paths: <code>uv</code> itself (<code
            >command -v uv</code
          >), your clone, and the directory holding your acquisitions and libraries. <code
            >MSMCP_ALLOWED_ROOT</code
          > is the file boundary — without it the server falls back to whichever directory the client
          happened to start it in.
        </p>
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Tools
      =================================================================== */
  }
  <section id="tools" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Tools</p>
    <h2 class="mt-3 max-w-3xl rule-heading">Fourteen tools, one question each.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      Every call below is the signature the server actually advertises, with the argument names and
      defaults a client receives from <code>tools/list</code>. Tools that take a spectrum you have
      already loaded take the reference handle, not the peaks.
    </p>

    <div class="mt-9 space-y-9">
      {
        toolGuide.map((group) => (
          <section aria-labelledby={`tools-${group.id}`}>
            <h3 id={`tools-${group.id}`} class="text-[0.85rem] font-semibold text-head">
              {group.area}
            </h3>
            <dl class="mt-3">
              {group.tools.map((tool) => (
                <div
                  class="grid gap-1 border-t border-line-soft py-4 sm:grid-cols-[13rem_1fr] sm:gap-6"
                  data-tool={tool.name}
                >
                  <dt class="font-mono text-[0.82rem] font-medium text-head">{tool.name}</dt>
                  <dd class="min-w-0">
                    <p class="text-[0.9rem] text-ink">{tool.ask}</p>
                    <div class="mono-block mt-2 p-3 text-[0.78rem] whitespace-pre-wrap [overflow-wrap:anywhere]">
                      <code>{tool.call}</code>
                    </div>
                    <p class="mt-2 text-[0.82rem] leading-relaxed text-ink-soft">{tool.returns}</p>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    <p class="mt-7 text-[0.82rem] leading-relaxed text-ink-mute">
      Only <code>cancel_search</code> and <code>release_reference</code> change server state, and both
      advertise that on the wire so a host can gate them. Parameter bounds, defaults and validation live
      in the server's own tool schemas — this list is the map, the README is the reference.
    </p>
  </section>

  {
    /* ===================================================================
      Docs and links
      =================================================================== */
  }
  <section id="docs" class="shell scroll-mt-24 pb-8">
    <p class="eyebrow">Documentation & links</p>
    <h2 class="mt-3 rule-heading">Everything authoritative lives with the code.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      There is no separate documentation site, because two copies of a contract drift. Each link
      below goes to a maintained file in the repository.
    </p>

    <ul class="mt-7 grid gap-3 sm:grid-cols-2">
      {
        docs.map((d) => (
          <li>
            <a
              class="card flex h-full flex-col gap-1 p-4 transition-colors hover:border-accent"
              href={d.href}
              target="_blank"
              rel="noopener"
            >
              <span class="text-[0.9rem] font-semibold text-ink">{d.label}</span>
              <span class="font-mono text-[0.72rem] text-ink-mute">{d.note} ↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-[0.88rem] text-ink-soft">
      <span class="font-semibold text-ink">Contact.</span> There is no mailing list and no contact form.
      Bug reports, questions and feature discussion belong in{" "}
      <a class="prose-link" href={`${REPO}/issues`}>GitHub Issues</a>, where the answer stays
      searchable for the next person.
    </p>
  </section>
</BaseLayout>
