---
import BaseLayout from "../layouts/BaseLayout.astro";
import IsotopeFigure from "../components/IsotopeFigure.astro";
import ReferenceFlow from "../components/ReferenceFlow.astro";

const title = "MSMCP — a local MCP server for mass spectrometry";
const description =
  "An open-source, local Model Context Protocol server for mass spectrometry: inspect mzML and MGF spectra, calculate exact masses, compare MS/MS spectra and review QC metrics.";

const REPO = "https://github.com/janusson/MSMCP";

/* Source install today.  `uv sync` installs the core runtime only; no imaging
   backend is required.  The extras are named in the prose beside the block. */
const installSnippet = [
  "git clone https://github.com/janusson/MSMCP.git",
  "cd MSMCP",
  "uv sync                 # core runtime; no imaging backend required",
  "uv run msmcp            # serves MCP over stdio; waits for a client",
].join("\n");

const zedSnippet = JSON.stringify(
  {
    context_servers: {
      msmcp: {
        command: "/absolute/path/to/uv",
        args: ["run", "--directory", "/absolute/path/to/MSMCP", "msmcp"],
        env: { MSMCP_ALLOWED_ROOT: "/absolute/path/to/ms-data" },
      },
    },
  },
  null,
  2,
);

/* An illustrative workflow, not a recorded acquisition or a benchmark.  The
   paths, indices and returned handles are placeholders for the caller's own
   data; no acquisition or library is bundled. */
const workflow = [
  {
    title: "1 · Find an MS2 query",
    call: 'list_spectra(file_path="/absolute/path/to/ms-data/experiment.mzML", ms_level=2, min_peaks=1)',
    note: "Choose a zero-based spectrum index from the returned table. Index 0 is often an MS1 survey scan, not an MS/MS query. Check the reported retention time and precursor metadata; do not fill in missing acquisition metadata.",
  },
  {
    title: "2 · Load only that spectrum",
    call: 'load_spectrum(file_path="/absolute/path/to/ms-data/experiment.mzML", spectrum_index=CHOSEN_INDEX)',
    note: "Replace CHOSEN_INDEX with the integer you selected. The response gives metadata and an opaque ptr:spectrum:… reference. Keep the returned reference; the peak arrays stay in server memory.",
  },
  {
    title: "3 · Search a local MS/MS library",
    call: 'search_library(spectrum_reference="RETURNED_REFERENCE", database_file="/absolute/path/to/ms-data/libraries/reference.msp", scoring_method="classical", instrument_class="generic")',
    note: "Replace RETURNED_REFERENCE with the actual handle. Supply your own MSP or MGF library under the allowed root. This call returns a job ID, not a result table. The generic classical matching window is ±0.02 Da; choose an instrument profile that fits your data rather than assuming the default does.",
  },
  {
    title: "4 · Poll, inspect, release",
    call: 'check_search_status(job_id="RETURNED_JOB_ID")',
    note: "Use the actual job ID and poll until completion or failure. Review the named query spectrum, library source, scorer, applied precursor tolerance and context-eligibility counts. Use cancel_search to stop work and release_reference when you no longer need the loaded spectrum.",
  },
];

/* The tool surface, as the server advertises it: fifteen registrations in
   src/msmcp/tools/*.py, checked against `tools/list` by the project's own
   contract test.  Every call below is a real signature — the argument names and
   defaults are the ones a client receives — and the words on the right are what
   the tool's report actually contains, not a wish list. */
const toolGuide = [
  {
    id: "inspection",
    area: "Inspection and references",
    tools: [
      {
        name: "load_mzml_summary",
        ask: "What is in this file?",
        call: `load_mzml_summary(file_path="/data/run.mzML", max_spectra=5)`,
        returns:
          "Per spectrum: MS level, retention time, total ion current, peak count, base peak. The footer states the file's total spectrum count.",
      },
      {
        name: "list_spectra",
        ask: "Which spectra are MS2, and which index do I want?",
        call: `list_spectra(file_path="/data/run.mzML", ms_level=2)`,
        returns:
          "An index table — spectrum index, MS level, retention time, precursor m/z, peak count — so the next call names a real spectrum.",
      },
      {
        name: "extract_chromatograms",
        ask: "Show the TIC, base-peak and selected-ion traces for this run.",
        call: `extract_chromatograms(file_path="/data/run.mzML", xic_targets=[315.2321])`,
        returns:
          "Structured scan-level TIC, BPC and optional XIC traces from one bounded pass, with the source, scan coverage and provenance attached. Returns structured data, not a text table.",
      },
      {
        name: "load_spectrum",
        ask: "Hold one spectrum server-side.",
        call: `load_spectrum(file_path="/data/run.mzML", spectrum_index=966)`,
        returns:
          "Metadata plus a ptr:spectrum:… handle. The peak array stays in the server's memory instead of entering the conversation.",
      },
      {
        name: "summarise_reference",
        ask: "What is behind this handle?",
        call: `summarise_reference(reference="ptr:spectrum:264a5ae9…")`,
        returns:
          "The same compact spectrum block, read from memory rather than the file, followed by the reference's provenance.",
      },
      {
        name: "release_reference",
        ask: "Free that memory now rather than waiting for expiry.",
        call: `release_reference(reference="ptr:spectrum:264a5ae9…")`,
        returns:
          "Confirmation. Releasing an unknown or already-released reference is reported, not raised, so a retry is safe.",
      },
    ],
  },
  {
    id: "chemistry",
    area: "Exact-mass chemistry",
    tools: [
      {
        name: "validate_precursor",
        ask: "Does this precursor mass fit the formula I think it is?",
        call: `validate_precursor(theoretical_mass=315.2320, experimental_mass=315.2321)`,
        returns:
          "Mass error and a PASSED or REJECTED verdict against the named instrument class — 5.0 ppm for the generic class — with the tolerance stated.",
      },
      {
        name: "predict_adduct_offset",
        ask: "What does [M+H]+ add, exactly?",
        call: `predict_adduct_offset(adduct_string="[M+H]+")`,
        returns:
          "Polarity, charge state, exact mass shift in daltons and the offset formula. One of fourteen canonical adducts; anything else is refused.",
      },
      {
        name: "annotate_isotopes",
        ask: "What should the isotope envelope look like for this formula?",
        call: `annotate_isotopes(identifier="C6H12O6", isotopologues=3)`,
        returns:
          "Monoisotopic mass and the M, M+1, M+2 masses with relative abundances normalised to M = 1.0000, from the exact multinomial expansion.",
      },
    ],
  },
  {
    id: "similarity",
    area: "Spectral similarity",
    tools: [
      {
        name: "compute_cosine",
        ask: "How similar are these two MS/MS spectra?",
        call: `compute_cosine(query_reference="ptr:spectrum:…", reference_peaks=[[mz, intensity], …])`,
        returns:
          "A cosine score under the class's m/z window with the matched-peak count, computed by greedy one-to-one peak matching.",
      },
    ],
  },
  {
    id: "qc",
    area: "Quality control",
    tools: [
      {
        name: "generate_qc_summary",
        ask: "Was this run worth searching?",
        call: `generate_qc_summary(file_path="/data/run.mzML")`,
        returns:
          "Spectrum and total-ion-current counts, peak density, an estimated signal-to-noise ratio and diagnostic-ion prevalence, bounded by the configured spectrum cap. If the cap is reached, the report says complete coverage is unconfirmed.",
      },
    ],
  },
  {
    id: "search",
    area: "Library search",
    tools: [
      {
        name: "search_library",
        ask: "Match this MS2 against the library I already have.",
        call: `search_library(database_file="/data/libraries/MassBank.msp", spectrum_reference="ptr:spectrum:…", scoring_method="classical")`,
        returns:
          "A job ID straight away. The MSP/MGF library is read from disk through the same boundary as an acquisition. An MS1 or non-MS2 query is refused; for an MS2 query the stated precursor, polarity, charge and adduct are checked before ranking, and records missing context are labelled unknown rather than promoted.",
      },
      {
        name: "check_search_status",
        ask: "Is the scan finished?",
        call: `check_search_status(job_id="2aafd7b8…")`,
        returns:
          "Running, completed or failed — then the ranked report, naming the scorer, tolerances, library source and provenance.",
      },
      {
        name: "cancel_search",
        ask: "Stop the scan.",
        call: `cancel_search(job_id="2aafd7b8…")`,
        returns:
          "Cancellation. A job that already finished is reported as finished, and a cancelled scan's partial work is discarded.",
      },
    ],
  },
  {
    id: "diagnostics",
    area: "Diagnostics",
    tools: [
      {
        name: "ping",
        ask: "Is the server alive, and can it see its dependencies?",
        call: `ping()`,
        returns:
          "Operational status plus the installed package inventory. The optional imaging backend being absent is healthy in a core-only install. Call it first when another tool fails unexpectedly.",
      },
    ],
  },
];

const docs = [
  {
    label: "Quick start & tool reference",
    href: `${REPO}#try-it-in-60-seconds`,
    note: "README",
  },
  {
    label: "Architecture, layers & limitations",
    href: `${REPO}/blob/main/ARCHITECTURE.md`,
    note: "ARCHITECTURE.md",
  },
  {
    label: "Scientific validation status",
    href: `${REPO}/blob/main/SCIENTIFIC_VALIDATION.md`,
    note: "what is, and is not, validated",
  },
  {
    label: "Security notes",
    href: `${REPO}#security-notes`,
    note: "allowed root, size caps, stdio-only",
  },
  {
    label: "Configuration reference",
    href: `${REPO}#configuration-reference`,
    note: "environment variables",
  },
  { label: "Roadmap", href: `${REPO}/blob/main/docs/roadmap.md`, note: "plan of record" },
  { label: "Changelog", href: `${REPO}/blob/main/CHANGELOG.md`, note: "release history" },
  {
    label: "Citation metadata",
    href: `${REPO}/blob/main/CITATION.cff`,
    note: "CITATION.cff",
  },
  {
    label: "Releases & tags",
    href: `${REPO}/releases`,
    note: "tagged releases; PyPI publication pending",
  },
  { label: "Questions & bug reports", href: `${REPO}/issues`, note: "GitHub Issues" },
];
---

<BaseLayout title={title} description={description}>
  {
    /* ===================================================================
      Hero
      =================================================================== */
  }
  <section id="top" class="shell pt-14 pb-16 md:pt-20 md:pb-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
      <div class="min-w-0">
        <p class="eyebrow">Model Context Protocol server · Mass spectrometry</p>

        <h1
          class="mt-5 text-balance text-[clamp(2rem,5.2vw,3.1rem)] font-bold leading-[1.12] tracking-[-0.02em] text-head"
        >
          Ask your AI assistant about your mass spectrometry data.
        </h1>

        <p class="mt-6 max-w-2xl text-[1.08rem] leading-relaxed text-ink">
          MSMCP puts your own data in front of an AI client — Claude, Zed, or any other MCP host.
          Ask it to open an mzML or MGF file, check a precursor mass against a formula, compute
          isotope and adduct patterns, score an MS/MS spectrum against your MSP library, or
          summarise QC across a run. MCP is the open standard that lets an assistant call those
          tools and read the files it is given.
        </p>

        <p class="mt-4 max-w-2xl text-[1.02rem] font-medium leading-relaxed text-head">
          The model reasons. The tools compute.
        </p>

        <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">
          A matching precursor mass or a high spectral similarity is evidence to investigate, not a
          compound identification. MSMCP supports analytical reasoning; it does not replace
          reference standards, acquisition context or scientific judgement.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary" href="#get-started">
            Get started <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href="#example"> See an example </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2">
          <li class="chip">15 tools</li>
          <li class="chip">mzML · MGF · optional imzML</li>
          <li class="chip">stdio, local only</li>
          <li class="chip">no credentials</li>
          <li class="chip">MIT</li>
        </ul>
      </div>

      <div class="min-w-0 space-y-6">
        <div class="card p-4">
          <p class="text-[0.72rem] font-medium text-ink-mute">Run it from source</p>
          <pre
            class="mono-block mt-2 p-3 text-[0.75rem] whitespace-pre-wrap [overflow-wrap:anywhere]"
            aria-label="Install commands"><code>{installSnippet}</code></pre>
        </div>
        <ReferenceFlow />
      </div>
    </div>
  </section>

  {
    /* ===================================================================
      Example
      =================================================================== */
  }
  <section id="example" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Example workflow</p>
    <h2 class="mt-3 max-w-3xl rule-heading">Inspect first. Compare second. Interpret carefully.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      Illustrative MCP tool calls, not a recorded acquisition or a benchmark. Replace the paths,
      index and returned handles with your own. These are tool arguments for your MCP client, not
      shell commands. No acquisition or spectral library is bundled.
    </p>

    <div class="mt-8 overflow-hidden card">
      <div class="border-b border-line-soft px-5 py-3 text-[0.75rem] text-ink-mute">
        Local files → spectrum reference → background job → candidate review
      </div>
      <ol class="space-y-6 p-5">
        {
          workflow.map((step) => (
            <li class="min-w-0 space-y-3 border-l-2 border-accent-soft pl-4">
              <h3 class="font-mono text-[0.85rem] font-medium text-head">{step.title}</h3>
              <pre class="mono-block p-3.5" tabindex="0" aria-label={`${step.title}: tool call`}>
                <code>{step.call}</code>
              </pre>
              <p class="text-[0.85rem] leading-relaxed text-ink-soft">{step.note}</p>
            </li>
          ))
        }
      </ol>
      <div class="border-t border-line-soft px-5 py-4 text-[0.85rem] leading-relaxed text-ink-soft">
        <strong class="text-head">Similarity is not confidence.</strong> Treat candidate library matches
        as hypotheses, not validated compound identifications. Search significance is uncalibrated: the
        report makes no FDR, p-value, q-value or identification-confidence claim. The search contract
        is{" "}
        <code>msmcp.search.similarity.v1</code>, and MS1 or non-MS2 queries are refused rather than
        scored as MS/MS evidence.
      </div>
    </div>
  </section>

  <section id="why" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Why MSMCP</p>
    <h2 class="mt-3 max-w-3xl rule-heading">Separate computation from interpretation.</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      <article class="card min-w-0 p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Explicit calculations</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Exact masses, adduct shifts, isotope envelopes and precursor-mass checks come from code
          rather than a language model's memory. Compare like with like: a neutral monoisotopic mass
          is not an ion's m/z. Account for the adduct and charge before applying a precursor
          tolerance.
        </p>
      </article>
      <article class="card min-w-0 p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Traceable workflows</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Loaded spectra carry source and reader provenance. Search reports state their scorer,
          matching assumptions, the precursor tolerance actually applied and the context-eligibility
          counts. Long-running scans return job IDs for polling, so a client timeout cannot truncate
          the work.
        </p>
      </article>
      <article class="card min-w-0 p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Local data boundary</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          File access is confined to a configured root, with size and spectrum-count limits. The
          server runs under your operating-system account; this is not a sandbox. Your MCP client
          and model provider may receive paths, metadata and tool reports. Their privacy settings
          still matter even when peak arrays remain local.
        </p>
      </article>
    </div>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="min-w-0">
        <IsotopeFigure />
      </div>
      <div class="card min-w-0 p-5">
        <p class="eyebrow">What the source provides</p>
        <ul class="mt-4 space-y-3 text-[0.88rem] leading-relaxed text-ink-soft">
          <li>
            <strong class="text-ink">Acquisition readers:</strong> mzML (including supported compressed
            arrays), MGF and an optional imzML imaging adapter. Reader availability is not validation
            of every file variant or vendor export.
          </li>
          <li>
            <strong class="text-ink">Local libraries:</strong> MSP/NIST-style text and MGF library search.
            Inspect the report's library source: a synthetic fallback is test data, never evidence of
            a compound match.
          </li>
          <li>
            <strong class="text-ink">Context-aware candidates:</strong> MS level, precursor m/z, polarity,
            charge and isolation window are carried when stated; incompatible records are excluded before
            ranking, and missing context stays labelled unknown.
          </li>
          <li>
            <strong class="text-ink">Software checks:</strong> unit tests and an end-to-end evaluation
            notebook live with the server. Passing them checks software behaviour, not identification
            accuracy or universal instrument compatibility.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section id="limitations" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Scope & limitations</p>
    <h2 class="mt-3 max-w-3xl rule-heading">Know what a result does not establish.</h2>
    <ul class="mt-7 grid gap-4 text-[0.88rem] leading-relaxed text-ink-soft sm:grid-cols-2">
      <li class="card p-5">
        <strong class="text-head">No calibrated discovery claim.</strong> A cosine score is not a probability
        of correct identity. MSMCP's production search reports no p-values, q-values or FDR control, and
        historical significance output must not be read as an error rate. Independent compound-level calibration
        remains work to do.
      </li>
      <li class="card p-5">
        <strong class="text-head">Context gating is only as good as the metadata.</strong>{" "}
        An MS1 query is refused. For MS2 queries, a stated precursor outside the instrument-class tolerance,
        or a conflicting polarity, charge or adduct, excludes the record. A record that omits a field
        stays ranked but is labelled unknown, never promoted to a context-matched match.
      </li>
      <li class="card p-5">
        <strong class="text-head">Instrument defaults are assumptions.</strong> Named profiles select
        tolerances, not verified acquisition metadata. QC's base-peak/median-positive-intensity ratio
        is an estimated signal-to-noise proxy, not calibrated instrument SNR.
      </li>
      <li class="card p-5">
        <strong class="text-head">Formats have boundaries.</strong> Convert unsupported vendor files to
        mzML first. imzML depends on the optional{" "}
        <code>msmcp[imaging]</code> extra; its{" "}
        <code>massflow</code>{" "}package name collides with a separate analytical MassFlow project.
        Keep those installations separate; core mzML/MGF works without either.
      </li>
      <li class="card p-5">
        <strong class="text-head">Local stdio only.</strong> This page documents a local child process,
        not a hosted API or a validated remote transport. Not all format, transport and instrument combinations
        have been validated. Chromatogram extraction is shipped as a bounded tool, not a promise of universal
        acquisition coverage.
      </li>
    </ul>
  </section>

  <section id="get-started" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Get started</p>
    <h2 class="mt-3 rule-heading">Install from source. Connect a local client.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      Use the canonical{" "}
      <a class="prose-link" href={REPO}> MSMCP repository </a>{" "}
      and
      <a class="prose-link" href="https://docs.astral.sh/uv/"> uv </a>
      . The server requires Python 3.13+ and MCP SDK 2.0+. The commands below describe a source checkout,
      not a published-package install. MSMCP itself needs no API key; your chosen AI client may have separate
      requirements or costs.
    </p>

    <aside class="mt-5 card border-accent-soft p-5" aria-labelledby="install-status">
      <h3 id="install-status" class="font-semibold text-head">Installation status</h3>
      <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-soft">
        The core package installs from a built wheel in a fresh Python 3.13 environment without the
        imaging backend; <code>massflow</code> is not a core dependency. Install{" "}
        <code>msmcp[imaging]</code>{" "}only when you need imzML, and never in the same environment
        as the separate analytical MassFlow engine. The package is not yet published to PyPI, so the
        source path below is the supported installation today.
      </p>
    </aside>

    <div class="mt-7 grid gap-6 lg:grid-cols-2">
      <div class="min-w-0">
        <h3 class="text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ink-mute">
          Clone, sync, run
        </h3>
        <pre
          class="mono-block mt-3 p-4"
          tabindex="0"
          aria-label="Source installation commands"><code>{installSnippet}</code></pre>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          A running stdio server waits for an MCP client; it is not a web page. Stop a manual run
          with Ctrl+C before letting your client launch its own process. Optional{" "}
          <code>uv sync --extra chem</code> adds RDKit for SMILES input;{" "}
          <code>uv sync --extra imaging</code> adds imzML. Use{" "}
          <code>uv sync --extra dev</code> only when you need development tools.
        </p>
      </div>
      <div class="min-w-0">
        <h3 class="text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ink-mute">
          Example: Zed settings
        </h3>
        <pre
          class="mono-block mt-3 p-4"
          tabindex="0"
          aria-label="Zed MCP configuration"><code>{zedSnippet}</code></pre>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          Merge this into your settings and replace all three absolute paths. Find uv with{" "}
          <code>command -v uv</code>; select your clone directory and an existing data directory
          containing both acquisitions and libraries. <code>--directory</code>{" "}
          sets the project working directory, while <code>MSMCP_ALLOWED_ROOT</code>{" "}
          defines the file-access boundary.
        </p>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          Restart the server in your client and call <code>ping</code> first to inspect dependency availability.
          Other stdio MCP clients use their own configuration schema; this is not a universal settings
          file.
        </p>
      </div>
    </div>
  </section>

  <section id="tools" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Tools</p>
    <h2 class="mt-3 max-w-3xl rule-heading">Fifteen tools, one question each.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      Every call below is the signature the server actually advertises, with the argument names and
      defaults a client receives from <code>tools/list</code>. Tools that take a spectrum you have
      already loaded take the reference handle, not the peaks.
    </p>

    <div class="mt-9 space-y-9">
      {
        toolGuide.map((group) => (
          <section aria-labelledby={`tools-${group.id}`}>
            <h3 id={`tools-${group.id}`} class="text-[0.85rem] font-semibold text-head">
              {group.area}
            </h3>
            <dl class="mt-3">
              {group.tools.map((tool) => (
                <div
                  class="grid gap-1 border-t border-line-soft py-4 sm:grid-cols-[13rem_1fr] sm:gap-6"
                  data-tool={tool.name}
                >
                  <dt class="font-mono text-[0.82rem] font-medium text-head">{tool.name}</dt>
                  <dd class="min-w-0">
                    <p class="text-[0.9rem] text-ink">{tool.ask}</p>
                    <div class="mono-block mt-2 p-3 text-[0.78rem] whitespace-pre-wrap [overflow-wrap:anywhere]">
                      <code>{tool.call}</code>
                    </div>
                    <p class="mt-2 text-[0.82rem] leading-relaxed text-ink-soft">{tool.returns}</p>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    <p class="mt-7 text-[0.82rem] leading-relaxed text-ink-mute">
      Only <code>cancel_search</code> and <code>release_reference</code> change server state, and both
      advertise that on the wire so a host can gate them. Parameter bounds, defaults and validation live
      in the server's own tool schemas — this list is the map, the README is the reference.
    </p>
  </section>

  <section id="docs" class="shell scroll-mt-24 pb-8">
    <p class="eyebrow">Documentation & links</p>
    <h2 class="mt-3 rule-heading">Follow the code, not a frozen feature claim.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      There is no separate documentation site, because two copies of a contract drift. Each link
      below goes to a maintained file in the repository. Main, open pull requests and tagged
      releases describe different states; check the revision before relying on an example.
    </p>

    <ul class="mt-7 grid gap-3 sm:grid-cols-2">
      {
        docs.map((d) => (
          <li>
            <a
              class="card flex h-full flex-col gap-1 p-4 transition-colors hover:border-accent"
              href={d.href}
            >
              <span class="text-[0.9rem] font-semibold text-ink">{d.label}</span>
              <span class="font-mono text-[0.72rem] text-ink-mute">{d.note} ↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-[0.88rem] text-ink-soft">
      <strong class="text-ink">Contact.</strong> Bug reports and feature discussion belong in
      <a class="prose-link" href={`${REPO}/issues`}> GitHub Issues </a>
      . Built by
      <a class="prose-link" href="https://github.com/janusson"> Eric Janusson </a>
      ; find articles on analytical chemistry and scientific software at
      <a class="prose-link" href="https://www.ericjanusson.ca"> ericjanusson.ca </a>
      .
    </p>
  </section>
</BaseLayout>
