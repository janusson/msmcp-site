---
import BaseLayout from "../layouts/BaseLayout.astro";
import IsotopeFigure from "../components/IsotopeFigure.astro";
import ReferenceFlow from "../components/ReferenceFlow.astro";

const title = "MSMCP — ask questions of mass spectrometry data, directly";
const description =
  "An open-source, local Model Context Protocol server for mass spectrometry: inspect spectra, calculate exact masses, compare MS/MS spectra and review QC metrics.";
const REPO = "https://github.com/janusson/MSMCP";

const installSnippet = [
  "git clone https://github.com/janusson/MSMCP.git",
  "cd MSMCP",
  "uv sync                 # installs the source project's dependencies",
  "uv run msmcp            # serves MCP over stdio; waits for a client",
].join("\n");

const zedSnippet = JSON.stringify(
  {
    context_servers: {
      msmcp: {
        command: "/absolute/path/to/uv",
        args: ["run", "--directory", "/absolute/path/to/MSMCP", "msmcp"],
        env: { MSMCP_ALLOWED_ROOT: "/absolute/path/to/ms-data" },
      },
    },
  },
  null,
  2,
);

const workflow = [
  {
    title: "1 · Find an MS2 query",
    call: 'list_spectra(file_path="/absolute/path/to/ms-data/experiment.mzML", ms_level=2, min_peaks=1)',
    note: "Choose a zero-based spectrum index from the returned table. Index 0 is often an MS1 survey scan, not an MS/MS query. Check the reported retention-time units and precursor metadata; do not fill in missing acquisition metadata.",
  },
  {
    title: "2 · Load only that spectrum",
    call: 'load_spectrum(file_path="/absolute/path/to/ms-data/experiment.mzML", spectrum_index=CHOSEN_INDEX)',
    note: "Replace CHOSEN_INDEX with the integer you selected. The response gives metadata and an opaque ptr:spectrum:… reference. Keep the returned reference; the peak arrays stay in server memory.",
  },
  {
    title: "3 · Search a local MS/MS library",
    call: 'search_library(spectrum_reference="RETURNED_REFERENCE", database_file="/absolute/path/to/ms-data/libraries/reference.msp", scoring_method="classical", instrument_class="generic")',
    note: "Replace RETURNED_REFERENCE with the actual handle. Supply your own MSP or MGF library under the allowed root. This call returns a job ID, not a result table. The generic classical matching window is ±0.02 Da; choose an appropriate instrument profile rather than assuming that default fits your data.",
  },
  {
    title: "4 · Poll, inspect, release",
    call: 'check_search_status(job_id="RETURNED_JOB_ID")',
    note: "Use the actual job ID and poll until completion or failure. Review the named query spectrum, library source, scorer and tolerances. Use cancel_search to stop work, and release_reference when you no longer need the loaded spectrum. References expire and do not survive a server restart.",
  },
];

const tools = [
  {
    area: "Inspection & references",
    names: [
      "load_mzml_summary",
      "list_spectra",
      "load_spectrum",
      "summarise_reference",
      "release_reference",
    ],
  },
  {
    area: "Exact-mass chemistry",
    names: ["predict_adduct_offset", "annotate_isotopes", "validate_precursor"],
  },
  { area: "Spectral similarity", names: ["compute_cosine"] },
  { area: "Quality control", names: ["generate_qc_summary"] },
  { area: "Library search", names: ["search_library", "check_search_status", "cancel_search"] },
  { area: "Diagnostics", names: ["ping"] },
];

const docs = [
  { label: "Quick start & tool reference", href: `${REPO}#try-it-in-60-seconds`, note: "README" },
  {
    label: "Architecture & boundaries",
    href: `${REPO}/blob/main/ARCHITECTURE.md`,
    note: "Architecture",
  },
  {
    label: "Security notes",
    href: `${REPO}#security-notes`,
    note: "Allowed root, resource caps, stdio",
  },
  {
    label: "Configuration reference",
    href: `${REPO}#configuration-reference`,
    note: "Environment variables",
  },
  {
    label: "Roadmap",
    href: `${REPO}/blob/main/docs/roadmap.md`,
    note: "Planned work is not shipped behavior",
  },
  { label: "Changelog", href: `${REPO}/blob/main/CHANGELOG.md`, note: "Change history" },
  { label: "Source & installation issues", href: REPO, note: "Canonical repository" },
  { label: "Questions & bug reports", href: `${REPO}/issues`, note: "GitHub Issues" },
];
---

<BaseLayout title={title} description={description}>
  <section id="top" class="shell pt-14 pb-16 md:pt-20 md:pb-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
      <div class="min-w-0">
        <p class="eyebrow">Model Context Protocol server · Mass spectrometry</p>
        <h1
          class="mt-5 text-balance text-[clamp(2rem,5.2vw,3.1rem)] font-bold leading-[1.12] tracking-[-0.02em] text-head"
        >
          Ask questions of mass spectrometry data—directly.
        </h1>
        <p class="mt-6 max-w-2xl text-[1.08rem] leading-relaxed text-ink">
          MSMCP connects AI workflows to computational tools for spectral inspection, exact-mass
          chemistry, quality control and library comparison.
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">
          The model plans and interprets; the tools compute against files on your machine. Load a
          spectrum once, pass a short reference between tools, and keep large peak arrays out of the
          conversation.
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">
          A matching precursor mass or a high spectral similarity is evidence to investigate, not a
          compound identification. MSMCP supports analytical reasoning; it does not replace
          reference standards, acquisition context or scientific judgement.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="btn btn-primary" href="#get-started"
            >Get started <span aria-hidden="true">→</span></a
          >
          <a class="btn btn-ghost" href="#example">See a workflow</a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Project at a glance">
          <li class="chip">Open source · MIT</li>
          <li class="chip">Local stdio MCP</li>
          <li class="chip">Python 3.13+</li>
        </ul>
      </div>
      <ReferenceFlow />
    </div>
  </section>

  <section id="example" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Example workflow</p>
    <h2 class="mt-3 max-w-3xl rule-heading">Inspect first. Compare second. Interpret carefully.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      Illustrative MCP tool calls, not a recorded acquisition or a benchmark. Replace the paths,
      index and returned handles with your own. These are tool arguments for your MCP client, not
      shell commands. No acquisition or spectral library is bundled.
    </p>
    <div class="mt-8 card overflow-hidden">
      <div class="border-b border-line-soft px-5 py-3 text-[0.75rem] text-ink-mute">
        Local files → spectrum reference → background job → candidate review
      </div>
      <ol class="space-y-6 p-5">
        {
          workflow.map((step) => (
            <li class="min-w-0 space-y-3 border-l-2 border-accent-soft pl-4">
              <h3 class="font-mono text-[0.85rem] font-medium text-head">{step.title}</h3>
              <pre class="mono-block p-3.5" tabindex="0" aria-label={`${step.title}: tool call`}>
                <code>{step.call}</code>
              </pre>
              <p class="text-[0.85rem] leading-relaxed text-ink-soft">{step.note}</p>
            </li>
          ))
        }
      </ol>
      <div class="border-t border-line-soft px-5 py-4 text-[0.85rem] leading-relaxed text-ink-soft">
        <strong class="text-head">Similarity is not confidence.</strong> Treat candidate library matches
        as hypotheses, not validated compound identifications. Search significance is uncalibrated; this
        site makes no FDR, p-value, q-value or identification-confidence claim. The similarity-only search
        contract is pending server integration, not a claim about an already released version.
      </div>
    </div>
  </section>

  <section id="why" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Why MSMCP</p>
    <h2 class="mt-3 max-w-3xl rule-heading">Separate computation from interpretation.</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-3">
      <article class="card min-w-0 p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Explicit calculations</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Exact masses, adduct shifts, approximate isotope envelopes and precursor-mass checks come
          from code rather than a language model's memory. Compare like with like: a neutral
          monoisotopic mass is not an ion's m/z. Account for the adduct and charge before applying a
          precursor tolerance.
        </p>
      </article>
      <article class="card min-w-0 p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Traceable workflows</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Loaded spectra carry source and reader provenance. Search reports state their scorer and
          matching assumptions. Long-running library scans return job IDs for polling, so the client
          does not have to hold one request open for the entire scan.
        </p>
      </article>
      <article class="card min-w-0 p-5">
        <h3 class="font-mono text-[0.95rem] font-semibold text-head">Local data boundary</h3>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          File access is confined to a configured root, with size and spectrum-count limits. The
          server runs under your operating-system account; this is not a sandbox. Your MCP client
          and model provider may receive paths, metadata and tool reports. Their privacy settings
          still matter even when peak arrays remain local.
        </p>
      </article>
    </div>
    <div class="mt-8 grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="min-w-0"><IsotopeFigure /></div>
      <div class="card min-w-0 p-5">
        <p class="eyebrow">What the source provides</p>
        <ul class="mt-4 space-y-3 text-[0.88rem] leading-relaxed text-ink-soft">
          <li>
            <strong class="text-ink">Acquisition readers:</strong> mzML (including supported compressed
            arrays), MGF and an imzML imaging adapter. Reader availability is not validation of every
            file variant or vendor export.
          </li>
          <li>
            <strong class="text-ink">Local libraries:</strong> MSP/NIST-style text and MGF library search.
            Inspect the report's library source: a synthetic fallback is test data, never evidence of
            a compound match.
          </li>
          <li>
            <strong class="text-ink">Classical comparison:</strong> greedy one-to-one peak matching. Optional
            embedding scorers need their own compatible packages and model weights; missing backends must
            not be mistaken for a learned score.
          </li>
          <li>
            <strong class="text-ink">Software checks:</strong> unit tests and an end-to-end evaluation
            notebook live with the server. Passing them checks software behavior, not identification accuracy
            or universal instrument compatibility.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section id="limitations" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Scope & limitations</p>
    <h2 class="mt-3 rule-heading">Know what a result does not establish.</h2>
    <ul class="mt-7 grid gap-4 text-[0.88rem] leading-relaxed text-ink-soft sm:grid-cols-2">
      <li class="card p-5">
        <strong class="text-head">No calibrated discovery claim.</strong> A cosine score is not a probability
        of correct identity. Do not use historical search significance output to claim error-rate control.
        Independent compound-level calibration remains work to do.
      </li>
      <li class="card p-5">
        <strong class="text-head">Instrument defaults are assumptions.</strong> Named profiles select
        tolerances, not verified acquisition metadata. QC's base-peak/median-positive-intensity ratio
        is an estimated signal-to-noise proxy, not calibrated instrument SNR.
      </li>
      <li class="card p-5">
        <strong class="text-head">Formats have boundaries.</strong> Convert unsupported vendor files to
        mzML first. imzML depends on an imaging backend; its <code>massflow</code> package name collides
        with a separate analytical MassFlow project. Resolution is being handled independently; neither
        interoperability nor imaging installation is promised here.
      </li>
      <li class="card p-5">
        <strong class="text-head">Local stdio only.</strong> This page documents a local child process,
        not a hosted API or a validated remote transport. Not all format, transport and instrument combinations
        have been validated. Chromatogram extraction remains <a
          class="prose-link"
          href={`${REPO}/pull/63`}>open PR #63</a
        >, not a shipped feature on main.
      </li>
    </ul>
  </section>

  <section id="get-started" class="shell scroll-mt-24 pb-16 md:pb-24">
    <p class="eyebrow">Get started</p>
    <h2 class="mt-3 rule-heading">Install from source. Connect a local client.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      Use the canonical <a class="prose-link" href={REPO}>MSMCP repository</a> and <a
        class="prose-link"
        href="https://docs.astral.sh/uv/">uv</a
      >. Current main requires Python 3.13+ and MCP SDK 2.0+; older Python 3.12 instructions are not
      compatible. The commands below describe a source checkout, not a published-package install.
      MSMCP itself needs no API key; your chosen AI client may have separate requirements or costs.
    </p>
    <aside class="mt-5 card border-accent-soft p-5" aria-labelledby="install-status">
      <h3 id="install-status" class="font-semibold text-head">Installation status</h3>
      <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-soft">
        The core imaging dependency/name collision is still being resolved. This website change does
        not validate a clean server installation. If dependency resolution or backend imports fail,
        check the repository's current guidance and issues; do not substitute the unrelated
        analytical MassFlow package. The site can build independently of the server.
      </p>
    </aside>
    <div class="mt-7 grid gap-6 lg:grid-cols-2">
      <div class="min-w-0">
        <h3 class="text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ink-mute">
          Clone, sync, run
        </h3>
        <pre
          class="mono-block mt-3 p-4"
          tabindex="0"
          aria-label="Source installation commands"><code>{installSnippet}</code></pre>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          A running stdio server waits for an MCP client; it is not a web page. Stop a manual run
          with Ctrl+C before letting your client launch its own process. Optional{" "}
          <code>uv sync --extra chem</code> adds RDKit for SMILES input. Use{" "}
          <code>uv sync --extra dev</code> only when you need development tools.
        </p>
      </div>
      <div class="min-w-0">
        <h3 class="text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ink-mute">
          Example: Zed settings
        </h3>
        <pre
          class="mono-block mt-3 p-4"
          tabindex="0"
          aria-label="Zed MCP configuration"><code>{zedSnippet}</code></pre>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          Merge this into your settings and replace all three absolute paths. Find uv with{" "}
          <code>command -v uv</code>; select your clone directory and an existing data directory
          containing both acquisitions and libraries. Absolute data paths avoid ambiguity:
          <code>--directory</code> sets the project working directory, while{" "}
          <code>MSMCP_ALLOWED_ROOT</code> defines the file-access boundary, not a new working directory.
        </p>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-ink-soft">
          Restart the server in your client and call <code>ping</code> first to inspect dependency availability.
          Other stdio MCP clients use their own configuration schema; this is not a universal settings
          file.
        </p>
      </div>
    </div>
    <div class="mt-10 card p-5">
      <h3 class="text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-ink-mute">
        14 tools in server main, grouped by task
      </h3>
      <dl class="mt-4 grid gap-x-8 gap-y-4 sm:grid-cols-2">
        {
          tools.map((group) => (
            <div class="min-w-0">
              <dt class="text-[0.82rem] font-semibold text-head">{group.area}</dt>
              <dd class="mt-1 font-mono text-[0.78rem] leading-relaxed text-ink-soft">
                {group.names.join(" · ")}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 text-[0.8rem] text-ink-mute">
        Inventory checked against main on 18 October 2026. Your checkout or tagged release may
        differ; inspect the tools your client actually discovers. Loading spectra creates in-memory
        references; searching creates jobs. These are stateful operations even though acquisition
        files are read-only.
      </p>
    </div>
  </section>

  <section id="docs" class="shell scroll-mt-24 pb-8">
    <p class="eyebrow">Documentation & links</p>
    <h2 class="mt-3 rule-heading">Follow the code, not a frozen feature claim.</h2>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      The repository is the source of truth for installation, tool signatures and current work.
      Main, open pull requests and tagged releases describe different states; check the revision
      before relying on an example or report.
    </p>
    <ul class="mt-7 grid gap-3 sm:grid-cols-2">
      {
        docs.map((doc) => (
          <li>
            <a
              class="card flex h-full flex-col gap-1 p-4 transition-colors hover:border-accent"
              href={doc.href}
            >
              <span class="text-[0.9rem] font-semibold text-ink">{doc.label}</span>
              <span class="font-mono text-[0.72rem] text-ink-mute">
                {doc.note} <span aria-hidden="true">↗</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-[0.88rem] text-ink-soft">
      <strong class="text-ink">Contact.</strong> Bug reports and feature discussion belong in{" "}
      <a class="prose-link" href={`${REPO}/issues`}>GitHub Issues</a>. Built by{" "}
      <a class="prose-link" href="https://github.com/janusson">Eric Janusson</a>; find articles on
      analytical chemistry and scientific software at{" "}
      <a class="prose-link" href="https://www.ericjanusson.ca">ericjanusson.ca</a>.
    </p>
  </section>
</BaseLayout>
